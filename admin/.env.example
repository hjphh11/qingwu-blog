# 清吾后台（admin/）的环境变量。
#
# 本地：复制本文件为 admin/.env（已被 gitignore）
# 服务器：写进 /opt/qingwu/.env，并把权限设为 600
#   chmod 600 /opt/qingwu/.env

# ——— 必填 ———
# 登录密码的 argon2 哈希（**不存明文**）。生成：
#   cd admin && npm run hash-password -- 你的密码
ADMIN_PASSWORD_HASH=

# 会话 cookie 的签名密钥，随便一串长随机字符（至少 16 位）：
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=

# ——— 选填 ———
# 博客仓库路径。默认是 admin/ 的上一级（本地就是博客仓库根目录）；
# 服务器上按方案是 /opt/qingwu/repo
# ADMIN_REPO_PATH=/opt/qingwu/repo

# 只监听本地，对外由 tailscale serve 转发（**不开公网端口**）
# ADMIN_HOST=127.0.0.1
# ADMIN_PORT=3000

# 登录态保留天数（默认 7）
# ADMIN_SESSION_DAYS=7

# 会话 cookie 是否带 Secure 标志。默认与 NODE_ENV 一致（production 就带）。
#
# ⚠️ 只有一种情况需要设成 0：后台走的是**明文 HTTP**（本项目因为服务器签不下
#    HTTPS 证书，用的是 `tailscale serve --http`）—— 因为浏览器在 http 下不会
#    保存 Secure cookie，登录会失效。
#    此时流量仍由 WireGuard 端到端加密、且只有 tailnet 内可达，所以可以接受。
#    一旦换成真正的 HTTPS 访问，**必须删掉这一项**恢复 Secure。
# ADMIN_COOKIE_SECURE=0

# ——— 阶段 I：发布与回滚 ———

# GitHub 细粒度 PAT（qingwu-blog 仓库 Contents: Write）。发布/回滚要用它推送。
# **只经子进程环境变量传给 git**，不写进命令行、不落盘、不写 git config。
# 不配这一项 → 后台只能保存内容，不能发布（发布页会明确提示）。
# ADMIN_GIT_TOKEN=github_pat_xxx

# Vercel Deploy Hook URL（选填）。配上就由后台在推送后主动触发重建；
# 不配也能用 —— Vercel 自己会检测到 push 后重建，只是慢一点。
# ADMIN_DEPLOY_HOOK=https://api.vercel.com/v1/integrations/deploy/prj_xxx/xxx

# 操作日志目录（选填）。默认 <仓库>/.admin-logs/（已 gitignore），只记发布/回滚/审批友链。
# ADMIN_LOG_PATH=/opt/qingwu/repo/.admin-logs

# ——— 阶段 J：友链申请审批 ———

# 友链申请数据存在**私有仓库**里（含访客邮箱，绝不能进公开仓库），
# 后台走 GitHub Contents API 读它，并把「通过/拒绝」写回去（= 改 status）。
# PAT 需要该私有仓库的 **Contents: Read and write**
#（和 Vercel 函数写申请用的是同一类 token，可以直接复用同一个值）。
# 不配这一项 → 后台「友链申请」页只显示「没配 token」的提示，其它功能不受影响。
# ADMIN_APPLY_TOKEN=github_pat_xxx
# ADMIN_APPLY_REPO=hjphh11/qingwu-link-applications
# ADMIN_APPLY_PATH=applications.json
# ADMIN_APPLY_REF=main
# 本地联调时可以指向 mock 服务（测试脚本用的就是它）
# ADMIN_APPLY_API_BASE=http://127.0.0.1:4600
# 审批列表的服务端缓存（毫秒，默认 45000；测试时设 0 关掉缓存）
# ADMIN_APPLY_CACHE_MS=45000

# 刷题页题库代理（/api/questions）所需的环境变量。
# 题库不放在本仓库,而是放在私有仓库,由服务端函数代取。
#
# 生成 token：GitHub → Settings → Developer settings → Personal access tokens
#   → Fine-grained tokens → Generate new token
#     · Repository access: Only select repositories → 勾选 python-exam-quiz-bank
#     · Permissions → Repository permissions → Contents: Read-only
#
# 本地开发：把值填进 .env（该文件已被 .gitignore 忽略，不会提交）。
# 线上：Vercel → 项目 → Settings → Environment Variables → 添加 BANK_TOKEN（Sensitive）。
BANK_TOKEN=

# 以下为选填，不填则用默认值：
# BANK_REPO=hjphh11/python-exam-quiz-bank
# BANK_PATH=questions.json
# BANK_REF=master

# ————————————————————————————————————————————————
# 友链申请（页面 /links/apply、接口 /api/links/apply）—— 后台方案阶段 B
# ————————————————————————————————————————————————
#
# 申请数据含**访客邮箱**，不能进公开仓库，所以单独存一个**私有仓库**：
#   1) 新建私有仓库，例如 hjphh11/qingwu-link-applications（带 README 初始化即可）
#   2) 生成细粒度 PAT：Repository access → Only select repositories → 勾选该私有仓库
#      Permissions → Repository permissions → Contents: Read and write
#   3) 把 PAT 填到 APPLY_TOKEN
APPLY_TOKEN=

# 以下选填，不填则用默认值：
# APPLY_REPO=hjphh11/qingwu-link-applications
# APPLY_PATH=applications.json
# APPLY_REF=main

# Cloudflare Turnstile 人机验证（免费，防刷）
# 注意：站点密钥是**公开**的（本来就会出现在页面里），私密密钥只放服务端。
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 邮件通知（Resend，免费 100 封/天）—— 选填，不填则不发邮件（申请仍会存进私有仓库）
# 需要先在 Resend 验证发信域名 qingwu.ink（即给域名加 SPF/DKIM 的 DNS 记录）
# RESEND_API_KEY=re_xxxxxxxxxxxx
# APPLY_MAIL_FROM=清吾博客 <noreply@qingwu.ink>
# APPLY_NOTIFY_TO=1454109769@qq.com

# —— 以下仅本地联调用，正式环境不用填 ——
# 把对外请求指向本地 mock 服务，可以不起真仓库、不发真邮件地跑通整条链路：
# APPLY_GITHUB_API_BASE=http://127.0.0.1:4599
# TURNSTILE_VERIFY_URL=http://127.0.0.1:4599/turnstile/v0/siteverify
# RESEND_API_BASE=http://127.0.0.1:4599

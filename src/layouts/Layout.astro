---
/*
 * 字体不再从 @fontsource 全量引入（那会带进 174 个分片 / 13MB）。
 * 现在用 scripts/subset-fonts.py 生成的子集，@font-face 在 fonts.css 里，
 * 由 styles/index.css 统一引 —— 所以这里只留一个样式入口。
 */
import '../styles/global.css';
import ClientRouter from 'astro/components/ClientRouter.astro';
import { SITE } from '../config';
import { WORKER_BASE } from '../lib/workerBase';

import Navbar from '../components/Navbar.tsx';
import Footer from '../components/Footer.astro';
import BackgroundDecor from '../components/BackgroundDecor.tsx';
import MiniPlayer from '../components/MiniPlayer.tsx';
import Splash from '../components/Splash.tsx';
import ImageZoom from '../components/ImageZoom.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /**
   * 不要页脚。给「整屏就是一个画布」的页面用（目前只有 /gallery 画市）：
   * 那一页的墙是 position:fixed 铺满视口的，页脚留在文档流里只会藏在墙背面，
   * 还会让页面多出一截可滚动高度（滚轮一动，墙不动、内容在下面跑）。
   */
  bare?: boolean;
}

const {
  title = SITE.title,
  description = SITE.description,
  image = SITE.ogImage,
  bare = false,
} = Astro.props;
const pathname = Astro.url.pathname;
const url = SITE.url.replace(/\/$/, '') + pathname;

// 访问统计的打点地址。线上同源 `/api/hit`（nginx 转给本地 Worker），
// dev 下 astro 的 /api 代理同样转到 8799 —— 本地也能看到打点。
const hitEndpoint = `${WORKER_BASE}/hit`;
---

<!doctype html>
<html lang={SITE.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/images/emis/avatar.png" />
    <link rel="apple-touch-icon" href="/images/emis/avatar.png" />
    <meta name="q-hit-endpoint" content={hitEndpoint} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />

    <ClientRouter />

    {/* 开屏阶段的立绘要立刻可用 —— 否则爱弥斯是「先空着、图到了才浮出来」。
        只在首页预加载:开屏也只在首页播,别的页面白下载 400KB 没有意义。 */}
    {pathname === '/' && (
      <link
        rel="preload"
        as="image"
        href="/images/emis/full.webp"
        type="image/webp"
        fetchpriority="high"
      />
    )}

    {/* 标题字体预加载：首屏每个页面都有 .page-head 标题，用的就是 ZCOOL XiaoWei。
        不 preload 的话浏览器要等 CSS 解析完才发现它，标题会先以系统宋体出现再换 —— 
        947KB 的字体在慢网下这段闪烁会很长。
        只 preload 标题体，**不 preload 手写体**（10KB 且只在开屏/空态出现，优先级低）。 */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/zcool-xiaowei-subset.woff2"
      crossorigin
    />

    {/* 光标预加载：cursor 的图是"用到了才请求"，不预载的话第一次移到链接上
        会先闪一帧系统指针。整套 5 张加起来才 5KB，这里只挑最常用的两张
        （默认箭头 + 可点击），文本那两张等真正进正文时再取也可以。 */}
    <link rel="preload" as="image" href="/images/cursor/normal.png" />
    <link rel="preload" as="image" href="/images/cursor/link.png" />

    {/* 画市的图在 R2（img.qingwu.ink）—— 提前把 TCP+TLS 握好，
        墙铺下来时才不会每张图都先等一个 RTT。只在这一页加，别的不白连。 */}
    {
      pathname.startsWith('/gallery') && (
        <link rel="preconnect" href="https://img.qingwu.ink" crossorigin />
      )
    }

    {/* 滚动揭示启用标记:让 .reveal 只在 JS 可用时才隐藏,避免无 JS 时内容缺失 */}
    <script is:inline>
      document.documentElement.classList.add('qjs');
    </script>

    {/* 高对比阅读:在首次绘制之前把类加上,否则开过这个开关的人会先看到
        一帧低对比、再跳成高对比。默认关,所以只对开过的人生效。 */}
    <script is:inline>
      try {
        if (localStorage.getItem('qingwu:contrast') === '1') {
          document.documentElement.classList.add('q-contrast');
        }
      } catch (e) {
        /* 隐私模式下读不到,就按默认（关）走 */
      }
    </script>

    {/* 开屏:在第一次绘制之前就判定这次要不要播,并给 <html> 打标记 ——
        铺奶油幕布、先把首页立绘藏起来、锁住滚动。这三件事必须早于首帧,
        否则会出现「首页已经画出来了 → 开屏层才盖上来」的闪一下。
        ⚠️ 判定条件必须与 components/Splash.tsx 完全一致,否则会出现
        「幕布铺上了但没人来收」—— 访客被锁在没有立绘、不能滚动的页面上。 */}
    <script is:inline>
      (function () {
        try {
          if (location.pathname !== '/') return;
          if (sessionStorage.getItem('qingwu:splash')) return;
          var root = document.documentElement;
          root.classList.add('q-splash-pending');
          // 兜底:万一开屏层没能接管(脚本报错 / 被拦 / 打包失败),5 秒后自己
          // 把幕布撤掉。宁可少播一次开屏,也不能把访客锁死在空白页上。
          setTimeout(function () {
            if (!window.__qSplashTaken) root.classList.remove('q-splash-pending');
          }, 5000);
        } catch (e) {
          /* sessionStorage 不可用(隐私模式等)就直接看首页,不播开屏 */
        }
      })();
    </script>

    {/* 后台标签页时暂停所有持续动画(樱花 canvas / 氛围光斑 / 唱片 / 声波):
        切走之后没人看,继续跑只是白烧 CPU 和电量。 */}
    <script is:inline>
      (function () {
        if (window.__qVisibility) return;
        window.__qVisibility = true;
        var root = document.documentElement;
        var sync = function () {
          root.classList.toggle('qhidden', document.hidden);
          window.dispatchEvent(new CustomEvent('qingwu:visibility', { detail: !document.hidden }));
        };
        document.addEventListener('visibilitychange', sync);
        sync();
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fdf6f0" />

    <link rel="canonical" href={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={SITE.url.replace(/\/$/, '') + image} />
    <meta property="og:site_name" content={SITE.title} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={SITE.url.replace(/\/$/, '') + image} />
  </head>
  <body>
    {/* 路由切换进度条(样式见 global.css 的 .q-route):ClientRouter 早就在跑,
        但切页时界面完全没反应 —— 点「文章」到新内容出现之间是静默的。
        这条 2px 绯红→琥珀的线明确「跳转发生了」。 */}
    <div class="q-route" aria-hidden="true">
      <div class="q-route__bar" id="q-route-bar"></div>
    </div>

    <Navbar pathname={pathname} client:load />
    {/* 开屏:只在首页播、每会话一次,三阶段总时长 2.0s(见 Splash.tsx 顶部说明)。
        改动只在这一个 prop 上 —— 1600 更紧凑、2400 更舒展,都不影响正确性。 */}
    <Splash client:load dur={2000} />
    <BackgroundDecor client:only="react" />
    <MiniPlayer client:only="react" />

    <slot />

    {!bare && <Footer />}

    {/* 正文图片灯箱：全站可用（文章页 / 关于页 / 项目页的 .prose 都吃）。
        纯 DOM + document 事件委托，ClientRouter 换 body 之后不需要重新绑定。 */}
    <ImageZoom />

    {/* 访问统计打点（方案 §11 路线 B）：每次进入页面打一个点，失败静默 —— 绝不能影响访客。
        · 本地开发地址默认不打点（免得把本地自己的访问算进线上统计）；
          自测时可以在页面里先设 `window.__Q_HIT_ALWAYS = true` 强制打开。
        · 同一次访问里连打两次也没关系：服务端对「同一访客同一页 30 分钟内」只计一次。 */}
    <script is:inline>
      (function () {
        if (window.__qHitWired) return;
        window.__qHitWired = true;

        // 访客上报地址由 Layout 通过 <meta name="q-hit-endpoint"> 注入：
        // 线上默认是 Cloudflare Worker（写 D1）的绝对地址；自建/局域网版是 /api/hit。
        // 兜底值只能是**同源**的 `/api/hit`：这个 meta 永远存在，兜底理论上用不到，
        // 万一哪天模板改坏了，落到 api.qingwu.ink 会让自建版把数据打到线上 Worker，
        // 而落到同源最多是打不出去 —— 错得更安全。
        var meta = document.querySelector('meta[name="q-hit-endpoint"]');
        var HIT_ENDPOINT = (meta && meta.getAttribute('content')) || '/api/hit';

        function sendHit() {
          try {
            var h = location.hostname;
            var local = h === 'localhost' || h === '127.0.0.1' || h === '' || h === '0.0.0.0';
            if (local && !window.__Q_HIT_ALWAYS) return;

            var payload = JSON.stringify({
              path: location.pathname,
              referrer: document.referrer || '',
            });
            if (navigator.sendBeacon) {
              // sendBeacon 的好处：页面正在关闭/切换时也能发出去
              navigator.sendBeacon(HIT_ENDPOINT, new Blob([payload], { type: 'application/json' }));
            } else {
              fetch(HIT_ENDPOINT, {
                method: 'POST',
                body: payload,
                headers: { 'content-type': 'application/json' },
                keepalive: true,
              }).catch(function () {});
            }
          } catch (e) {
            /* 打点失败不影响任何东西 */
          }
        }

        // 客户端路由（ClientRouter）切页也会触发，正好逐页计数
        document.addEventListener('astro:page-load', sendHit);
      })();
    </script>

    {/* 路由进度条驱动。⚠️ 进度条元素每次切页都会被换掉(ClientRouter 会替换 body),
        所以 listen 一次、每次用 getElementById 重新取,不能把元素引用缓存下来。 */}
    <script is:inline>
      (function () {
        if (window.__qRoute) return;
        window.__qRoute = true;

        // 只有「发生了跳转」才画这条线 —— astro:page-load 在首次进入时也会触发,
        // 不区分的话每次打开页面都会在顶上闪一条 100% 的线。
        var navigating = false;
        var tail = [];

        function bar() {
          return document.getElementById('q-route-bar');
        }
        function clearTail() {
          tail.forEach(clearTimeout);
          tail = [];
        }
        function setRoute(pct) {
          var el = bar();
          if (!el) return;
          clearTail();
          if (pct >= 100) {
            // 到 100% 之后延迟归零,否则会残留一条线挂在顶上
            el.style.width = '100%';
            el.style.opacity = '1';
            tail.push(
              setTimeout(function () {
                el.style.opacity = '0';
                tail.push(
                  setTimeout(function () {
                    el.style.transition = 'none';
                    el.style.width = '0';
                    tail.push(
                      setTimeout(function () {
                        el.style.transition = '';
                      }, 60),
                    );
                  }, 300),
                );
              }, 260),
            );
            return;
          }
          el.style.width = pct + '%';
          el.style.opacity = '1';
        }

        document.addEventListener('astro:before-preparation', function () {
          navigating = true;
          setRoute(30);
        });
        document.addEventListener('astro:after-swap', function () {
          if (navigating) setRoute(88);
        });
        document.addEventListener('astro:page-load', function () {
          if (!navigating) return;
          navigating = false;
          setRoute(100);
        });
      })();
    </script>

    {/* 卡片聚光:全局指针追踪,把 --mx/--my(px) 写到聚光卡片,驱动 .card-spotlight 的径向光斑 */}
    <script is:inline>
      if (!window.__qCardSpotlight) {
        window.__qCardSpotlight = true;
        document.addEventListener(
          'pointermove',
          function onMove(e) {
            const t = e.target;
            if (!(t instanceof Element)) return;
            const el = t.closest('.card-spotlight');
            if (!el) return;
            const r = el.getBoundingClientRect();
            el.style.setProperty('--mx', (e.clientX - r.left).toFixed(1) + 'px');
            el.style.setProperty('--my', (e.clientY - r.top).toFixed(1) + 'px');
          },
          { passive: true },
        );
      }
    </script>

    {/* 按钮涟漪:全局委托,点击 .btn-ripple 时在指针处生成一圈玫瑰粉涟漪 */}
    <script is:inline>
      if (!window.__qBtnRipple) {
        window.__qBtnRipple = true;
        document.addEventListener(
          'click',
          function onRipple(e) {
            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
            const t = e.target;
            if (!(t instanceof Element)) return;
            const el = t.closest('.btn-ripple');
            if (!el) return;
            const r = el.getBoundingClientRect();
            const s = Math.max(r.width, r.height);
            const span = document.createElement('span');
            span.className = 'ripple';
            span.style.width = span.style.height = s + 'px';
            span.style.left = e.clientX - r.left - s / 2 + 'px';
            span.style.top = e.clientY - r.top - s / 2 + 'px';
            el.appendChild(span);
            span.addEventListener('animationend', function () {
              span.remove();
            });
          },
          { passive: true },
        );
      }
    </script>

    {/* 图片占位淡出:给 .q-media 在图片加载完成时打上 is-loaded(样式见 global.css)。
        ⚠️ 三个必须:
        · 用**捕获阶段**的 load 监听 —— load 事件不冒泡,但会在捕获阶段经过 document。
        · 必须补扫一次 img.complete —— 命中缓存的图在脚本挂上之前就已经加载完了,
          那个 load 事件永远不会再触发,不补扫就会永远停在占位层上。
        · **不要碰 React 拥有的容器**(带 data-media-self 的),那些由组件自己管 ——
          水合前改它的 class 会触发 React 的 hydration mismatch 警告
          (实测:`<picture>` 上报 `q-media` vs `q-media is-loaded`)。 */}
    <script is:inline>
      (function () {
        if (window.__qMedia) return;
        window.__qMedia = true;

        function mark(el) {
          if (!(el instanceof HTMLImageElement)) return;
          var box = el.closest('.q-media');
          if (!box || box.hasAttribute('data-media-self')) return;
          box.classList.add('is-loaded');
        }
        function scan() {
          document.querySelectorAll('.q-media:not([data-media-self]) img').forEach(function (img) {
            if (img.complete && img.naturalWidth > 0) mark(img);
          });
        }

        document.addEventListener('load', function (e) { mark(e.target); }, true);
        // 图挂了也把占位层撤掉:一张加载失败的图应该看得见(诚实),而不是
        // 永远停在一个看着像「还在加载」的粉色块上。
        document.addEventListener('error', function (e) { mark(e.target); }, true);
        scan();
        document.addEventListener('astro:page-load', scan);
      })();
    </script>

    {/* 滚动揭示:全局 IntersectionObserver,进入视口给 .reveal 上淡入 */}
    <script is:inline>
      if (!window.__qReveal) {
        window.__qReveal = true;
        var io =
          'IntersectionObserver' in window
            ? new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                  if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    io.unobserve(entry.target);
                  }
                });
              }, { rootMargin: '0px 0px -12% 0px', threshold: 0.08 })
            : null;
        function observeReveals() {
          document.documentElement.classList.add('qjs');
          var els = document.querySelectorAll('.reveal:not(.is-visible)');
          if (!io) {
            els.forEach(function (el) {
              el.classList.add('is-visible');
            });
            return;
          }
          els.forEach(function (el) {
            io.observe(el);
          });
        }
        observeReveals();
        document.addEventListener('astro:page-load', observeReveals);
      }
    </script>
  </body>
</html>

---
import Layout from '../../layouts/Layout.astro';
import { friends } from '../../data/links';

const sites = friends.map(f => ({
  host: f.url.replace(/^https?:\/\/(?:www\.)?/i, '').split('/')[0].toLowerCase(),
  name: f.name, avatar: f.avatar,
}));
---
<Layout title="友文 · 清吾" description="朋友们最近写了什么，从这里翻到原文。">
  <div class="page-shell">
    <header class="wall-head">
      <div><h1>友文</h1><p>朋友们最近写了什么，都在这里。</p></div>
      <a href="/links/">回友链墙 <span aria-hidden="true">→</span></a>
    </header>
    <friend-post-wall data-friend-posts data-sites={JSON.stringify(sites)}>
      <p role="status" class="status">正在读取朋友们的文章…</p>
      <ul class="wall" data-list aria-label="朋友们最近发布的文章"></ul>
      <template>
        <li><a class="story" target="_blank" rel="noopener noreferrer">
          <div class="panel">
            <img class="cover" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" hidden />
            <div class="paper"><span class="mark" aria-hidden="true">“</span><p class="words"></p></div>
          </div>
          <h2></h2>
          <div class="credit">
            <span class="portrait"><span></span><img alt="" loading="lazy" referrerpolicy="no-referrer" hidden /></span>
            <span class="site"></span><time></time>
          </div>
        </a></li>
      </template>
    </friend-post-wall>
  </div>
</Layout>
<script>
  type FriendPost = { host: string; url: string; title: string; published?: string; image?: string; excerpt?: string };
  type Site = { host: string; name: string; avatar: string };

  function dateLabel(day: string) {
    const diff = Math.floor((Date.now() - Date.parse(day)) / 86400000);
    if (!Number.isFinite(diff)) return '';
    if (diff <= 0) return '今天';
    if (diff === 1) return '昨天';
    return diff < 30 ? `${diff} 天前` : day;
  }

  class FriendPostWall extends HTMLElement {
    private request?: AbortController;
    private sizes?: ResizeObserver;
    async connectedCallback() {
      const request = new AbortController();
      this.request = request;
      const list = this.querySelector('ul')!;
      const status = this.querySelector<HTMLElement>('.status')!;
      const template = this.querySelector('template')!;
      const sites = new Map((JSON.parse(this.dataset.sites!) as Site[]).map(site => [site.host, site]));
      try {
        const api = (import.meta.env.PUBLIC_HIT_WORKER_URL || '/api').replace(/\/$/, '');
        const response = await fetch(`${api}/link-posts`, { signal:request.signal });
        if (!response.ok) throw new Error('feed unavailable');
        const data = await response.json();
        if (!data.ok || !Array.isArray(data.items)) throw new Error('invalid feed');
        if (request.signal.aborted) return;
        const fragment = document.createDocumentFragment();
        for (const post of data.items as FriendPost[]) {
          if (!post.title || !/^https?:\/\//i.test(post.url)) continue;
          const item = template.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
          const site = sites.get(post.host);
          const name = site?.name || post.host;
          const link = item.querySelector('a')!;
          link.href = post.url;
          const title = item.querySelector('h2')!;
          title.textContent = post.title;
          const paper = item.querySelector<HTMLElement>('.paper')!;
          const excerpt = post.excerpt?.trim();
          item.querySelector('.words')!.textContent = excerpt || post.title;
          const cover = item.querySelector<HTMLImageElement>('.cover')!;
          const usePaper = () => {
            cover.hidden = true;
            paper.hidden = false;
            title.hidden = !excerpt || excerpt === post.title;
            item.classList.toggle('title-only', !excerpt);
          };
          usePaper();
          if (post.image && /^https:\/\//i.test(post.image)) {
            cover.addEventListener('error', usePaper, { once:true });
            // Keep the excerpt visible while a slow external image loads.
            cover.classList.add('pending');
            cover.addEventListener('load', () => {
              cover.classList.remove('pending');
              paper.hidden = true;
              title.hidden = false;
            }, { once:true });
            cover.hidden = false;
            cover.src = post.image;
          }
          item.querySelector('.site')!.textContent = name;
          item.querySelector('.portrait span')!.textContent = Array.from(name)[0];
          const avatar = item.querySelector<HTMLImageElement>('.portrait img')!;
          if (site?.avatar) {
            avatar.addEventListener('error', () => { avatar.hidden = true; }, { once:true });
            avatar.src = site.avatar;
            avatar.hidden = false;
          }
          if (post.published) {
            const time = item.querySelector('time')!;
            time.dateTime = time.title = post.published;
            time.textContent = dateLabel(post.published);
          }
          fragment.append(item);
        }
        list.replaceChildren(fragment);
        if (!list.children.length) { status.textContent = '暂时还没抓到文章，过一阵再来看看。'; return; }
        status.hidden = true;
        // Keep chronological DOM/tab order. Each new card fills the next available column.
        this.sizes = new ResizeObserver(entries => {
          for (const {target} of entries) {
            const tile = target.parentElement!;
            tile.style.gridRowEnd = `span ${Math.ceil(target.getBoundingClientRect().height + 20)}`;
          }
          list.classList.add('measured');
        });
        list.querySelectorAll('.story').forEach(card => this.sizes!.observe(card));
      } catch {
        if (!request.signal.aborted) status.textContent = '友文暂时读取失败，刷新页面可重试。';
      }
    }
    disconnectedCallback() { this.request?.abort(); this.sizes?.disconnect(); }
  }
  if (!customElements.get('friend-post-wall')) customElements.define('friend-post-wall', FriendPostWall);
</script>
<style>
  friend-post-wall { display:block; }
  .wall-head { display:flex; align-items:center; justify-content:space-between; gap:1rem; padding-bottom:1.4rem; margin-bottom:1.6rem; border-bottom:1px solid var(--color-hairline); }
  h1,h2,.words { font-family:var(--font-display); }
  h1 { font-size:clamp(2.7rem,5vw,4rem); line-height:1.15; }
  .wall-head p { margin-top:.55rem; color:var(--color-muted); }
  .wall-head a { flex:none; padding:.65rem 0; color:var(--color-accent); font-size:.9rem; }
  .wall { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); align-items:start; gap:20px 16px; }
  .wall.measured { grid-auto-rows:1px; row-gap:0; grid-auto-flow:row dense; }
  .wall li { min-width:0; --tint:#f4d8dc; --wash:#f6e7dd; }
  .wall li:nth-child(5n+2) { --tint:#e8dcf2; --wash:#dedff2; }
  .wall li:nth-child(5n+3) { --tint:#f7ebce; --wash:#f3ddcb; }
  .wall li:nth-child(5n+4) { --tint:#d8e8e2; --wash:#e4ece1; }
  .wall li:nth-child(5n) { --tint:#e0e4ef; --wash:#dbeaf0; }
  .story { display:block; overflow-wrap:anywhere; }
  .panel { position:relative; overflow:hidden; border-radius:1rem; background:linear-gradient(125deg,var(--wash),var(--tint)); }
  .cover { display:block; width:100%; min-height:7rem; max-height:22rem; object-fit:cover; }
  .cover.pending { position:absolute; inset:0; height:100%; opacity:0; }
  .wall [hidden],.status[hidden] { display:none; }
  .paper { padding:.85rem clamp(.95rem,1.6vw,1.45rem) 1.4rem; }
  .mark { display:block; height:2.25rem; font:3.8rem/1 Georgia,serif; color:color-mix(in srgb,var(--color-ink) 28%,transparent); }
  .words { font-size:clamp(1.12rem,1.55vw,1.38rem); line-height:1.6; display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:6; overflow:hidden; }
  .title-only .mark { display:none; }
  .title-only .paper { padding-block:2rem; }
  h2 { font-size:1.12rem; line-height:1.45; margin:.65rem .12rem 0; }
  .credit { display:flex; align-items:center; gap:.45rem; padding:.6rem .12rem 0; color:var(--color-subtle); font-size:.78rem; }
  .site { flex:1; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
  .portrait { position:relative; display:grid; place-items:center; background:var(--tint); color:var(--color-ink); width:1.4rem; height:1.4rem; border-radius:50%; overflow:hidden; }
  .portrait img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  .story:hover :is(h2,.words),.wall-head a:hover { color:var(--color-accent); }
  .story:focus-visible,.wall-head a:focus-visible { outline:2px solid var(--color-accent); outline-offset:3px; border-radius:.5rem; }
  .status { color:var(--color-muted); padding-block:1.5rem; }
  @media(max-width:1023px) { .wall { grid-template-columns:repeat(3,minmax(0,1fr)); } }
  @media(max-width:759px) { .wall { grid-template-columns:repeat(2,minmax(0,1fr)); column-gap:12px; } }
  @media(max-width:479px) {
    .wall { column-gap:10px; }
    .words { font-size:1rem; line-height:1.55; }
    .paper { padding:.7rem .8rem 1rem; }
    .cover { max-height:15rem; }
    h2 { font-size:1rem; }
    .credit { gap:.25rem; font-size:.72rem; }
  }
  @media(max-width:359px) { .wall { grid-template-columns:1fr; } }
</style>

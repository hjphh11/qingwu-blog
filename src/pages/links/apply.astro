---
import Layout from '../../layouts/Layout.astro';
import MorphIcon from 'morphicons/astro';
import { ArrowLeft, Info } from '../../lib/icons';
import LinkApply from '../../components/LinkApply.tsx';
---

<Layout
  title="友链申请 · 清吾"
  description="和清吾互换友链：填好站点名称、网址、头像与一句介绍，审核通过后会出现在友链页。"
>
  <div class="mx-auto max-w-4xl px-6 pb-20 pt-28">
    <a
      href="/links"
      class="reveal mb-6 inline-flex items-center gap-1 text-sm text-ink/60 transition-colors hover:text-crimson"
    >
      <MorphIcon icon={ArrowLeft} size={16} color="currentColor" />
      返回友链
    </a>

    <header class="reveal mb-6">
      <h1 class="flex items-center gap-3 font-display text-3xl text-ink">
        <span class="h-6 w-1.5 rounded-full bg-crimson"></span>
        友链申请
      </h1>
      <p class="mt-2 text-sm text-ink/60">
        填好下面这张表，我审核通过后就把你加进「友链」页 ~
      </p>
    </header>

    <!-- 事先说清楚：在线提交通道尚未接通（阶段 B 才接），别让访客白填 -->
    <div
      class="reveal mb-8 flex items-start gap-2.5 rounded-[var(--radius-card)] border border-amber/40 bg-amber/15 p-4 text-sm text-ink/80"
    >
      <span class="mt-0.5 shrink-0 text-amber">
        <MorphIcon icon={Info} size={17} color="currentColor" />
      </span>
      <p class="leading-relaxed">
        <span class="font-medium">在线提交通道还在建设中</span>
        ：表单已经能填、能校验，但正式接收申请的功能要下一阶段才上线。
        现在填好后可以用「用邮件发给我」把整理好的信息一次发过来，我会收到。
      </p>
    </div>

    <LinkApply client:load />
  </div>
</Layout>

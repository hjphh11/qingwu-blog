---
import Layout from '../../layouts/Layout.astro';
import ChatRoom from '../../components/ChatRoom.tsx';

/**
 * 长亭 · 聊天室
 *
 * 为什么是 `client:only`：这一页的内容完全取决于「现在有谁、说了什么」，
 * 服务端渲染出来的只会是一张空壳；更麻烦的是气泡里的相对时间
 * （`new Date(iso)` 取本地时区）在服务端和浏览器可能差一秒，hydration 会报不一致。
 * 直接跳过 SSR，让组件自己拉数据、自己画。
 *
 * 2026-11-25 换版：原来是「页头 + 聊天卡 + 侧栏」，现在是三栏玻璃卡布局。
 * h1 挪进左侧栏的品牌区（一页只留一个 h1），独立页头因此去掉。
 *
 * `bodyClass="q-chat-wide"`：长亭是应用页，版心比阅读页宽一档（1600 而不是 1240）。
 * 挂在 body 上，导航和页脚才会跟着一起变宽 —— 详见 chat.css ① 的说明。
 *
 * 和其他页的分工：留言是「一次性招呼」，长亭是「在场」。
 */
---

<Layout
  title="长亭 · 清吾"
  description="清吾的长亭，路过就进来坐坐。聊两句、发个表情，或者只是看看别人在说什么。"
  bodyClass="q-chat-wide"
>
  <div class="page-shell q-chat-page">
    <ChatRoom client:only="react" />
  </div>
</Layout>

<style>
  /* 这一页的样式**不在这里**，全在 src/styles/chat.css。
     原因：这一页的 `<style>` 实测没被加载（dev 下页面的 4 个内联 style 一个都不含
     `.q-chat-page`），写在这里等于死代码。以后这一页的样式都放进 chat.css。 */
</style>

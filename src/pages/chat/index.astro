---
import Layout from '../../layouts/Layout.astro';
import ChatRoom from '../../components/ChatRoom.tsx';

/**
 * 长亭 · 聊天室
 *
 * 为什么是 `client:only`：这一页的内容完全取决于「现在有谁、说了什么」，
 * 服务端渲染出来的只会是一张空壳；更麻烦的是气泡里的相对时间
 * （`new Date(iso)` 取本地时区）在服务端和浏览器可能差一秒，hydration 会报不一致。
 * 直接跳过 SSR，让组件自己拉数据、自己画。
 *
 * 和其他页的分工：留言是「一次性招呼」，长亭是「在场」。
 * 两边都保留 —— 把留言板改成聊天室，等于把「签名本」改写成「客厅」。
 */
---

<Layout
  title="长亭 · 清吾"
  description="清吾的长亭，路过就进来坐坐。聊两句、发个表情，或者只是看看别人在说什么。"
>
  <div class="page-shell q-chat-page">
    <header class="page-head">
      <div>
        <h1 class="page-head__title">长亭</h1>
        <p class="page-head__sub">十里一长亭，歇歇脚再说 ~</p>
      </div>
    </header>

    <ChatRoom client:only="react" />
  </div>
</Layout>

<style>
  /* 页头压缩、整页上移的规则**不在这里**，在 src/styles/chat.css 的
     `.q-chat-page` 那一段。

     原因：这一页的 `<style>` 实测根本没被加载 —— dev 下页面只有 4 个内联
     `<style>`，没有一条包含 `.q-chat-page`，于是「页头压薄」那套一直是死代码，
     页头实际还是 --space-section 的下边距。写进全局样式表之后才真正生效。
     以后这一页的样式都放进 chat.css，别再往这里写。 */
</style>

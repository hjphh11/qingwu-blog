---
import Layout from '../../layouts/Layout.astro';
import ChatRoom from '../../components/ChatRoom.tsx';

/**
 * 长亭 · 聊天室
 *
 * 为什么是 `client:only`：这一页的内容完全取决于「现在有谁、说了什么」，
 * 服务端渲染出来的只会是一张空壳；更麻烦的是气泡里的相对时间
 * （`新 Date(iso)` 取本地时区）在服务端和浏览器可能差一秒，hydration 会报不一致。
 * 直接跳过 SSR，让组件自己拉数据、自己画。
 *
 * 和留言板的分工：留言是「一次性招呼」，长亭是「在场」。
 * 两边都保留 —— 把留言板改成聊天室，等于把「签名本」改写成了「客厅」。
 */
---

<Layout
  title="长亭 · 清吾"
  description="清吾的长亭，路过就进来坐坐。聊两句、发个表情，或者只是看看别人在说什么。"
>
  <div class="page-shell">
    <header class="page-head">
      <div>
        <h1 class="page-head__title">长亭</h1>
        <p class="page-head__sub">十里一长亭，歇歇脚再说 ~</p>
      </div>
    </header>

    <ChatRoom client:only="react" />

    <p class="q-chat-away">
      聊天记录留在本站，不存储任何明文邮箱。
      说得太频繁会被请去喝口茶（限流），两分钟内的消息可以撤回。
    </p>
  </div>
</Layout>

<style>
  /* 页脚说明：别用 text-ink/NN 当正文（见 tokens 的约定），走 text-subtle */
  .q-chat-away {
    margin-top: 1rem;
    font-size: 0.75rem;
    line-height: 1.9;
    color: var(--color-subtle);
  }
</style>

---
import Layout from '../../layouts/Layout.astro';
import GalleryWall from '../../components/gallery/GalleryWall.tsx';
import { galleryItems as items, gallerySource } from '../../data/gallery';
---
{/*
  画市：一面可以往任意方向拖的图片墙。

  · 墙是 client:only —— 它的格数取决于视口宽高，服务端没有 window，先渲染出来
    再改尺寸会闪一下；而它是一个铺满视口的装饰性画布，不需要首屏就有内容。
  · 但「整页没有可读内容」对搜索和读屏都不友好，所以下面补了一份**服务端渲染**的清单：
    每条是一个指向原图的真链接（无 JS 也能看），有 JS 时 GalleryWall 会接管点击、
    改成打开站内的看大图层。这份清单视觉上藏起来（.sr-only），不进画面。
  · 页脚由 Layout 的 bare 关掉：整屏是画布，页脚只会藏在墙背后，还给页面多出可滚动高度。
*/}
<Layout
  title="画市 · 清吾"
  description="一面可以往任意方向拖的图片墙：拖着看，点开看大图。"
  bare
>
  <GalleryWall client:only="react" />

  <section class="sr-only" aria-label="画市图片列表">
    <h1>画市</h1>
    <p>
      一面可以往任意方向拖动的图片墙，共 {items.length} 张。下面是可以逐张打开的链接。
      图片来自 <a href={gallerySource}>{gallerySource}</a>。
    </p>
    <ul>
      {
        items.map((item, i) => (
          <li>
            <a href={`/images/gallery/${item.id}.webp`} data-gallery-open={i}>
              第 {i + 1} 张图，看大图
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>

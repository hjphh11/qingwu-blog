---
import Layout from '../../layouts/Layout.astro';
import GalleryWall from '../../components/gallery/GalleryWall.tsx';
import { galleryBase, galleryCount, gallerySample } from '../../data/gallery';

/* 服务端渲染的这一份清单只取构建期样本（60 条），不是全部一万多张：
   它的用途是「读屏能读到东西 / 没 JS 也能一张张点开 / 搜索引擎有内容」，
   不需要全量。交互那面墙由 GalleryWall 在浏览器里随机取一片索引去铺。 */
---
{/*
  画市：一面可以往任意方向拖的图片墙。

  · 墙是 client:only —— 它的格数取决于视口宽高，服务端没有 window，先渲染出来
    再改尺寸会闪一下；而且启动时要先取一片索引，SSR 无从预知。
  · 图在 R2（https://img.qingwu.ink/gallery/），索引跟站点同源
    （/gallery/data/N.json，见 scripts/build-gallery-index.py）。
  · 页脚由 Layout 的 bare 关掉：整屏是画布，页脚只会藏在墙背后，还给页面多出可滚动高度。
*/}
<Layout
  title="画市 · 清吾"
  description="一面可以往任意方向拖的图片墙：拖着看，点开看大图。"
  bare
>
  <GalleryWall client:only="react" />

  <section class="sr-only" aria-label="画市图片列表">
    <h1>画市</h1>
    <p>
      一面可以往任意方向拖动的图片墙，图库共 {galleryCount} 张，每次进来随机挑一批。
      下面这一小批是可以直接打开的链接。
    </p>
    <ul>
      {
        gallerySample.map((item) => (
          <li>
            <a href={`${galleryBase}/${item.id}.webp`} target="_blank" rel="noopener noreferrer">
              看大图（{item.w}×{item.h}）
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>

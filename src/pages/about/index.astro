---
import Layout from '../../layouts/Layout.astro';
import MorphIcon from 'morphicons/astro';
import { Mail, GitBranch } from '../../lib/icons';
import { profile, info, emis, contacts } from '../../data/about';

const contactIcons: Record<string, unknown> = { mail: Mail, github: GitBranch };
---

<Layout title="关于 · 清吾">
  <div class="mx-auto max-w-3xl px-6 pb-20 pt-28">
    <header class="mb-8">
      <h1 class="flex items-center gap-3 font-display text-3xl text-ink">
        <span class="h-6 w-1.5 rounded-full bg-crimson"></span>
        关于
      </h1>
      <p class="mt-2 text-sm text-ink/60">这里是清吾的小屋，和你打个招呼 ~</p>
    </header>

    {/* ① 我是清吾 */}
    <div class="glass-card p-8">
      <div class="flex flex-col items-center gap-4 sm:flex-row sm:items-start">
        <img
          src="/images/avatar.jpg"
          alt={profile.name}
          width={80}
          height={80}
          class="h-20 w-20 shrink-0 rounded-full object-cover ring-2 ring-white/70"
        />
        <div class="text-center sm:text-left">
          <h2 class="font-display text-2xl text-ink">{profile.name}</h2>
          <p class="mt-1 text-sm text-ink/60">{profile.tagline}</p>
        </div>
      </div>

      <div class="mt-6 space-y-3 leading-relaxed text-ink/80">
        <p>{profile.whyName}</p>
        <p>{profile.whyBlog}</p>
        <p>{profile.whatWrite}</p>
      </div>

      {/* 信息条目 */}
      <div class="mt-6 space-y-2 border-t border-rose/20 pt-5">
        {
          info.map((it) => (
            <p class="flex items-center gap-2 text-sm text-ink/70">
              <span>{it.icon}</span>
              <span class="text-ink/50">{it.label}</span>
              <span class="text-ink">{it.value}</span>
            </p>
          ))
        }
      </div>
    </div>

    {/* ② 爱弥斯 */}
    <div class="glass-card mt-6 flex flex-col gap-6 p-8 sm:flex-row">
      <img
        src={emis.img}
        alt="爱弥斯"
        width={180}
        height={180}
        class="mx-auto h-[180px] w-[180px] shrink-0 rounded-2xl object-cover sm:mx-0"
      />
      <div>
        <h2 class="font-display text-xl text-crimson">爱弥斯</h2>
        <div class="mt-3 space-y-3 leading-relaxed text-ink/80">
          {emis.persona.map((p) => (
            <p>{p}</p>
          ))}
        </div>
      </div>
    </div>

    {/* ③ 联系 / 社交 */}
    <div class="glass-card mt-6 p-8">
      <h2 class="flex items-center gap-2 font-display text-xl text-ink">
        <MorphIcon icon={Mail} size={18} color="currentColor" /> 联系 / 社交
      </h2>
      <div class="mt-4 space-y-2">
        {
          contacts.map((c) => (
            <button
              type="button"
              data-action={c.action}
              data-value={c.value}
              class="flex w-full items-center gap-2 rounded-xl px-3 py-2 text-left text-sm text-ink/80 transition-colors hover:bg-rose/10 hover:text-crimson"
            >
              <MorphIcon icon={contactIcons[c.icon] as never} size={16} color="currentColor" />
              <span>{c.label}</span>
              <span data-copy-msg class="ml-auto text-xs text-ink/40"></span>
            </button>
          ))
        }
      </div>
    </div>
  </div>
</Layout>

<script>
  document.querySelectorAll<HTMLElement>('[data-action]').forEach((el) => {
    el.addEventListener('click', async () => {
      const action = el.getAttribute('data-action');
      const value = el.getAttribute('data-value') || '';
      const msg = el.querySelector('[data-copy-msg]');

      if (action === 'link') {
        window.open(value, '_blank');
        return;
      }

      // copy
      try {
        await navigator.clipboard.writeText(value);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = value;
        document.body.appendChild(ta);
        ta.select();
        try {
          document.execCommand('copy');
        } catch {
          /* ignore */
        }
        ta.remove();
      }
      if (msg) {
        const prev = msg.textContent;
        msg.textContent = '已复制 ✓';
        msg.classList.add('text-crimson');
        setTimeout(() => {
          msg.textContent = prev;
          msg.classList.remove('text-crimson');
        }, 1200);
      }
    });
  });
</script>

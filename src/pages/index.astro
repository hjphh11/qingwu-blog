---
import Layout from '../layouts/Layout.astro';
import MorphIcon from 'morphicons/astro';
import { Sparkles, Flower2 } from '../lib/icons';
import { getCollection } from 'astro:content';
import Hero from '../components/Hero.tsx';
import CurrentTime from '../components/home/CurrentTime.tsx';
import VisitorCity from '../components/home/VisitorCity.tsx';
import StatsCard from '../components/home/StatsCard.tsx';
import TechStackCard from '../components/home/TechStackCard.astro';
import UptimeCard from '../components/home/UptimeCard.tsx';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Layout title="清吾 · qingwu.ink">
  <Hero client:load />

  <div class="mx-auto grid max-w-5xl gap-10 px-6 pb-20 md:grid-cols-[1fr_300px]">
    {/* 中央:文章流 */}
    <section>
      <h2 class="mb-6 flex items-center gap-2 font-display text-2xl text-ink">
        <span class="h-5 w-1.5 rounded-full bg-crimson"></span>
        最近文章
      </h2>

      <div class="flex flex-col gap-6">
        {
          posts.map((post) => (
            <a
              href={`/blog/${post.id}`}
              class="glass-card card-spotlight relative block p-6 transition-all hover:-translate-y-1"
            >
              <span class="absolute right-4 top-4" aria-hidden="true">
                <MorphIcon
                  icon={post.data.category === 'tech' ? Sparkles : Flower2}
                  size={18}
                  color="currentColor"
                />
              </span>
              <div class="flex items-center gap-2 text-xs text-ink/50">
                <span class="rounded-full bg-rose/25 px-2.5 py-0.5 text-crimson">
                  {post.data.category === 'tech' ? '技术' : '记录'}
                </span>
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('zh-CN')}
                </time>
              </div>
              <h3 class="mt-3 font-display text-xl text-ink">{post.data.title}</h3>
              <p class="mt-2 line-clamp-2 text-sm text-ink/60">{post.data.description}</p>
              <div class="mt-4 flex flex-wrap gap-x-3 gap-y-1 text-xs">
                {
                  post.data.tags.map((tag) => <span class="text-ink/50">#{tag}</span>)
                }
              </div>
            </a>
          ))
        }
      </div>
    </section>

    {/* 右栏卡片 */}
    <aside class="flex flex-col gap-8">
      <CurrentTime client:only="react" />
      <VisitorCity client:only="react" />
      <StatsCard articleCount={posts.length} client:only="react" />
      <TechStackCard />
      <UptimeCard client:only="react" />
    </aside>
  </div>
</Layout>

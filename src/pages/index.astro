---
import Layout from '../layouts/Layout.astro';
import ArticleGuide from '../components/home/ArticleGuide.astro';
import Hero from '../components/Hero.tsx';
import { getPublishedPosts, HOME_RECENT } from '../lib/posts';

const posts = (await getPublishedPosts()).slice(0, HOME_RECENT);
---
<Layout title="清吾 · qingwu.ink">
  <Hero client:load />
  <ArticleGuide posts={posts} />
</Layout>

---
import Layout from '../layouts/Layout.astro';
import MorphIcon from 'morphicons/astro';
import { categories, categoryLabel } from '../data/categories';
import { categoryIcon } from '../lib/categoryIcons';
import { getPublishedPosts, HOME_RECENT } from '../lib/posts';
import { profile } from '../data/about';
import Hero from '../components/Hero.tsx';
import CurrentTime from '../components/home/CurrentTime.tsx';
import VisitorCity from '../components/home/VisitorCity.tsx';
import StatsCard from '../components/home/StatsCard.tsx';
import TechStackCard from '../components/home/TechStackCard.astro';
import UptimeCard from '../components/home/UptimeCard.tsx';

// 首页只展示最近 5 篇，但右栏「写下的故事」要的是**全部**已发布文章数，
// 所以这里保留一份全量列表——之前直接把 posts.length 传给 StatsCard，
// 而 posts 已经被 slice(0,5) 截断，导致文章数永远显示 5。
const allPosts = await getPublishedPosts();
const posts = allPosts.slice(0, HOME_RECENT);

/* 左栏分类导航：**不做顶栏的复制品**。
   顶栏已经有「文章 / 音乐 / 友链 / 项目 / 关于」，左栏再列一遍只是重复；
   这里换成「按分类看 + 每类几篇」—— 这是顶栏没有的增量信息，
   点过去也能真的落到筛选后的列表（/blog?category=xxx，见 BlogList 的 init）。 */
const catCounts = new Map<string, number>();
for (const post of allPosts) {
  catCounts.set(post.data.category, (catCounts.get(post.data.category) ?? 0) + 1);
}
const catNav = [...categories]
  .sort((a, b) => a.order - b.order)
  .map((c) => ({ id: c.id, label: c.label, count: catCounts.get(c.id) ?? 0 }));
---
<Layout title="清吾 · qingwu.ink">
  <Hero client:load />

  {/*
    三栏：左「我」/ 中「文章」/ 右「此刻」。
    · 中间是内容主体，宽度自适应（minmax(0,1fr)，写 0 是为了让长标题能收缩而不是撑破）；
    · 两侧定宽 180 / 240 —— 参考里三栏博客的常见做法就是「两侧固定、中间 1fr」
      （如 grid-template-columns: 200px 1fr 200px）。这里的版心只有 1000px 内容宽，
      所以取 180 / 240 而非 200 / 200：右栏要放五张卡，比左栏更需要宽度。
    · 断点：≥1024 三栏；768–1024 两栏（左栏收起，作者信息与快捷入口在 Hero 与顶栏里都有）；
      <768 单栏，文章在上、卡片在下。
  */}
  <div
    class="page-shell grid gap-5 md:grid-cols-[minmax(0,1fr)_240px] lg:grid-cols-[180px_minmax(0,1fr)_240px]"
  >
    {/* ── 左栏：我是谁 + 按分类看 ───────────────────────────── */}
    <aside
      class="reveal hidden lg:sticky lg:top-24 lg:flex lg:flex-col lg:gap-4 lg:self-start"
      aria-label="关于与分类"
    >
      {/* data-author-card + q-author：吸顶时收起（见页面底部脚本）。
          导航栏里已经有一个头像 +「清吾」，这一张跟它并排时重复得很明显。
          ⚠️ padding 放在**内层**：收起靠 max-height: 0，而 padding 不会被 max-height
          压掉（浏览器保证高度不小于 padding 之和），放外层会残留 32px。 */}
      <div data-author-card class="q-author glass-card">
        <div class="flex flex-col items-center gap-1.5 p-4 text-center">
          <picture>
            <source srcSet="/images/avatar.webp" type="image/webp" />
            <img
              src="/images/avatar.jpg"
              alt="清吾头像"
              width={48}
              height={48}
              decoding="async"
              class="h-12 w-12 rounded-full object-cover ring-2 ring-white/70"
            />
          </picture>
          <span class="font-hand text-[1.35rem] leading-none text-ink">{profile.name}</span>
          {/* 简介直接取 about.json 的 tagline，不另写一段 —— 同一份信息两处措辞会打脸 */}
          <span class="text-xs leading-relaxed text-subtle">{profile.tagline}</span>
        </div>
      </div>

      <div class="glass-card p-1.5">
        <p class="px-2.5 pb-1 pt-1.5 text-[0.6875rem] tracking-[0.14em] text-subtle">按分类看</p>
        <nav class="flex flex-col" aria-label="按分类看文章">
          <a
            href="/blog"
            class="flex items-center justify-between rounded-xl px-2.5 py-1.5 text-[0.8125rem] text-muted transition-colors hover:bg-rose/15 hover:text-crimson"
          >
            <span>全部</span>
            <span class="tabular-nums text-subtle">{allPosts.length}</span>
          </a>
          {
            catNav.map((c) => (
              <a
                href={`/blog?category=${c.id}`}
                class="flex items-center justify-between rounded-xl px-2.5 py-1.5 text-[0.8125rem] text-muted transition-colors hover:bg-rose/15 hover:text-crimson"
              >
                <span>{c.label}</span>
                <span class="tabular-nums text-subtle">{c.count}</span>
              </a>
            ))
          }
        </nav>
      </div>
    </aside>

    {/* ── 中栏：文章流 ─────────────────────────────────────── */}
    <section class="reveal min-w-0">
      <h2 class="section-head mb-6">最近文章</h2>

      <div class="flex flex-col gap-5">
        {
          posts.map((post) => (
            <a
              href={`/blog/${post.id}`}
              class="glass-card card-spotlight group relative block p-6 card-lift sm:p-7"
            >
              <span
                class="absolute right-5 top-5 text-rose transition-colors group-hover:text-crimson"
                aria-hidden="true"
              >
                <MorphIcon
                  icon={categoryIcon(post.data.category) as never}
                  size={18}
                  color="currentColor"
                />
              </span>
              <div class="list-card-meta">
                <span class="chip chip--category">{categoryLabel(post.data.category)}</span>
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('zh-CN')}
                </time>
              </div>
              <h3 class="list-card-title pr-8">{post.data.title}</h3>
              <p class="list-card-desc line-clamp-2">{post.data.description}</p>
              <div class="list-card-foot">
                {post.data.tags.map((tag) => <span class="chip chip--tag">#{tag}</span>)}
              </div>
            </a>
          ))
        }
      </div>

      <a
        href="/blog"
        class="group mt-7 inline-flex items-center gap-1.5 py-2.5 text-sm text-muted transition-colors hover:text-accent"
      >
        查看全部文章
        <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1"
          >→</span
        >
      </a>
    </section>

    {/* ── 右栏：此刻的五张卡 ──────────────────────────────────
        这四张卡的数据都只能到客户端才有(时间/定位/localStorage/运行时长),
        之前一律 client:only —— 服务端渲染为空,整栏会在 JS 到位后一起弹出来。
        改成 client:load 后它们会参与服务端渲染:先出骨架,数据到位再换成真实
        内容(见 components/home/CardShell.tsx)。TechStackCard 是静态的,不需要壳。 */}
    <aside class="reveal flex min-w-0 flex-col gap-4" aria-label="此刻">
      <CurrentTime client:load />
      <VisitorCity client:load />
      <StatsCard articleCount={allPosts.length} client:load />
      <TechStackCard />
      <UptimeCard client:load />
    </aside>
  </div>

  <script>
    /*
     * 左栏作者卡：吸顶时收起，回顶部时展开。
     *
     * 为什么需要脚本：`position: sticky` 是否「已经粘住」在 CSS 里无法自证
     * （除非用 animation-timeline，兼容性还不够）。所以只能比较几何：
     * 卡片 sticky 的落点是 top-24 = 96px，**粘住之后 rect.top 恒等于 96**，
     * 而还没粘住时它一定大于 96 —— 这一条判据既准又不需要知道 Hero 多高。
     *
     * 为什么按 rect.top 而不是 scrollY 阈值：Hero 的高度随视口变化，
     * 写死一个 scrollY 数字在 900 高和 1200 高的屏上会差出上百像素。
     *
     * 与其它页面级脚本同样的模板（模块脚本首屏只跑一次，ClientRouter 换 body 后不重跑）：
     * teardown + init + 监听 astro:page-load + DOM 就绪也跑一次。
     */
    const STICK_TOP = 96; // 与 aside 的 lg:top-24 一致，改一处要改另一处
  
    let teardownAuthor = () => {};
  
    function initAuthorCard() {
      teardownAuthor();
  
    const card = document.querySelector<HTMLElement>('[data-author-card]');
    if (!card) return;
    // 诊断用：确认脚本真的跑到了这一步（与站内其它脚本一致的 __q* 标记习惯）
    (window as unknown as Record<string, unknown>).__qAuthor = true;
  
      let settleRaf = 0;
    let settleUntil = 0;
    let collapsed = false;

    const update = () => {
      const top = card.getBoundingClientRect().top;
      /* 判据是「真的粘住了」：sticky 落点就是 96，粘住后 top 恒等于 96。
         收起阈值给 +1（亚像素容差），展开阈值给 +20 —— 收起后卡片带
         translateY(-10px)，top 会变成 86，滞回必须大于这 10px，
         否则会在边缘反复收展。
         另外别写成 `collapsed ? top > B : top <= A`：那样算的是「另一个状态」的条件，
         结果正好相反（吸顶时来回抖、回顶部反而收起）。 */
      let next = collapsed;
      if (top <= STICK_TOP + 1) next = true;
      else if (top > STICK_TOP + 20) next = false;

      if (next === collapsed) return;
      collapsed = next;
      card.classList.toggle('is-collapsed', next);
      // 收起/展开改变左栏高度，读屏与键盘用户需要知道这块内容还在
      card.setAttribute('aria-hidden', next ? 'true' : 'false');
    };

    /* ⚠️ 为什么不是「scroll 里跑一次 rAF」：
       实测一次滚轮到位的滚动只派发 1 个 scroll 事件，而且**滚动结束后不再有事件**。
       于是最后一次采样停在中间位置（99），位置落到 96 时没人再看一眼 ——
       状态就卡住了。所以滚动后再持续追 400ms，直到位置稳定。
       每帧只读一次 rect，页面元素不多，代价可忽略。 */
    const settle = () => {
      update();
      if (performance.now() < settleUntil) settleRaf = requestAnimationFrame(settle);
      else settleRaf = 0;
    };

    const onScroll = () => {
      settleUntil = performance.now() + 400;
      if (!settleRaf) settleRaf = requestAnimationFrame(settle);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('scrollend', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update(); // 刷新后停在中间位置时也要有正确状态

    teardownAuthor = () => {
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('scrollend', onScroll);
      window.removeEventListener('resize', onScroll);
      if (settleRaf) cancelAnimationFrame(settleRaf);
    };
    }
  
    document.addEventListener('astro:page-load', initAuthorCard);
    if (document.readyState !== 'loading') initAuthorCard();
    else document.addEventListener('DOMContentLoaded', initAuthorCard, { once: true });
  </script>
</Layout>

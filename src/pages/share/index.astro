---
import Layout from '../../layouts/Layout.astro';
import MorphIcon from 'morphicons/astro';
import { Bookmark } from '../../lib/icons';
import { shares } from '../../data/share';

const filters = [
  { key: 'all', label: '全部' },
  { key: 'link', label: '收藏夹' },
  { key: 'quote', label: '语录' },
];

// 标签由数据汇总出来（方案第 38 条：分享加标签，前台可按标签筛选）
const allTags = [...new Set(shares.flatMap((s) => s.tags ?? []))].sort((a, b) =>
  a.localeCompare(b, 'zh'),
);
const tagsOf = (item: { tags?: string[] }) => (item.tags ?? []).join('|');
---

<Layout title="分享 · 清吾">
  <div class="mx-auto max-w-4xl px-6 pb-20 pt-28">
    <header class="mb-8">
      <h1 class="flex items-center gap-3 font-display text-3xl text-ink">
        <span class="h-6 w-1.5 rounded-full bg-crimson"></span>
        分享
      </h1>
      <p class="mt-2 text-sm text-ink/60">收藏的好东西 + 打动的句子，都放在这里 ~</p>
    </header>

    {/* 类型 + 标签筛选 */}
    <div class="mb-4 flex flex-wrap gap-2" data-share-filters>
      {
        filters.map((f) => (
          <button
            type="button"
            data-filter={f.key}
            class="btn-ripple rounded-full border border-rose/25 bg-white/50 px-4 py-1.5 text-sm text-ink/70 transition-all hover:border-rose/50 hover:text-crimson hover:shadow-[0_6px_18px_rgba(246,165,184,0.28)] active:scale-95"
          >
            {f.label}
          </button>
        ))
      }
    </div>

    {
      allTags.length > 0 && (
        <div class="mb-8 flex flex-wrap items-center gap-2" data-share-tags>
          <span class="text-xs text-ink/45">按标签：</span>
          {allTags.map((t) => (
            <button
              type="button"
              data-tag={t}
              class="rounded-full border border-rose/20 bg-white/40 px-3 py-1 text-xs text-ink/60 transition-all hover:border-rose/50 hover:text-crimson active:scale-95"
            >
              #{t}
            </button>
          ))}
        </div>
      )
    }

    {/* 混排内容 */}
    <div data-share-list class="reveal grid gap-6 sm:grid-cols-2">
      {
        shares.map((item) =>
          item.type === 'link' ? (
            <a
              href={item.url}
              target="_blank"
              rel="noreferrer"
              data-type="link"
              data-tags={tagsOf(item)}
              class="glass-card card-spotlight block p-6 transition-all hover:-translate-y-1"
            >
              <div class="flex items-center gap-2 text-xs text-rose">
                <MorphIcon icon={Bookmark} size={14} color="currentColor" /> 收藏
              </div>
              <p class="mt-2 font-display text-lg text-ink">{item.title}</p>
              <p class="mt-1 text-sm text-ink/60">{item.note}</p>
              <p class="mt-3 truncate text-xs text-ink/40">{item.url}</p>
              {
                (item.tags ?? []).length > 0 && (
                  <div class="mt-3 flex flex-wrap gap-1.5">
                    {item.tags.map((t: string) => (
                      <span class="rounded-full bg-rose/15 px-2 py-0.5 text-[11px] text-ink/50">
                        #{t}
                      </span>
                    ))}
                  </div>
                )
              }
            </a>
          ) : (
            /* 语录:3D 翻转卡(借鉴 MotionVault FlipCard,MIT,暖色)。正面=语录,背面=作者+一句标注。
               注意:.flip-inner 上**不能**放 glass-card 这类带 backdrop-filter 的样式,
               那会让 preserve-3d 失效、翻转后文字镜像(见 global.css 里的说明)。
               所以玻璃效果分给两个面各自承担。 */
            <div
              data-type="quote"
              data-tags={tagsOf(item)}
              class="flip-card h-[210px] cursor-pointer select-none"
            >
              <div class="flip-inner h-full w-full">
                <div class="flip-face glass-card flex flex-col border-l-4 border-rose/40 p-6">
                  <p class="font-display text-lg leading-relaxed text-ink">
                    「{item.text}」
                  </p>
                  {
                    (item.tags ?? []).length > 0 && (
                      <div class="mt-auto flex flex-wrap gap-1.5 pt-3">
                        {item.tags.map((t: string) => (
                          <span class="rounded-full bg-rose/15 px-2 py-0.5 text-[11px] text-ink/50">
                            #{t}
                          </span>
                        ))}
                      </div>
                    )
                  }
                </div>
                <div class="flip-face flip-back glass-card flip-back-tint flex flex-col items-center justify-center gap-1 border-l-4 border-rose/40 p-6">
                  <p class="font-display text-xl text-crimson">一句摘录</p>
                  {item.author && <p class="text-sm text-ink/70">— {item.author}</p>}
                </div>
              </div>
            </div>
          ),
        )
      }
    </div>
  </div>
</Layout>

<script>
  const list = document.querySelector('[data-share-list]');
  const filters = Array.from(document.querySelectorAll('[data-share-filters] button'));
  const tagBtns = Array.from(document.querySelectorAll('[data-share-tags] button'));

  // 类型 + 标签**叠加**筛选（方案第 38 条）
  let activeType = 'all';
  let activeTag: string | null = null;

  const apply = () => {
    if (!list) return;
    list.querySelectorAll<HTMLElement>('[data-type]').forEach((card) => {
      const typeOk = activeType === 'all' || card.getAttribute('data-type') === activeType;
      const tags = (card.getAttribute('data-tags') || '').split('|').filter(Boolean);
      const tagOk = !activeTag || tags.includes(activeTag);
      card.style.display = typeOk && tagOk ? '' : 'none';
    });
  };

  filters.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeType = btn.getAttribute('data-filter') || 'all';
      filters.forEach((b) => b.classList.remove('bg-rose/70', 'text-ink'));
      btn.classList.add('bg-rose/70', 'text-ink');
      apply();
    });
  });

  tagBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tag = btn.getAttribute('data-tag');
      // 再点一次取消选中
      activeTag = activeTag === tag ? null : tag;
      tagBtns.forEach((b) => {
        const on = b.getAttribute('data-tag') === activeTag;
        b.classList.toggle('bg-rose/70', on);
        b.classList.toggle('text-ink', on);
      });
      apply();
    });
  });

  // 点击切换翻转(桌面 + 触屏统一)
  document
    .querySelectorAll<HTMLElement>('.flip-card[data-type="quote"]')
    .forEach((card) => {
      card.addEventListener('click', () => card.classList.toggle('is-flipped'));
    });
</script>

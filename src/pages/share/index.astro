---
import Layout from '../../layouts/Layout.astro';
import { shares } from '../../data/share';

const links = shares.filter(s => s.type === 'link');
const quotes = shares.filter(s => s.type === 'quote');
const sections = [
  { kind: 'postcard', title: '语录明信片', items: quotes.slice(0, 1) },
  { kind: 'bookmarks', title: '收藏夹', items: links },
  { kind: 'notebook', title: '摘录页', items: quotes.slice(1) },
];
const tags = [...new Set(shares.flatMap(s => s.tags))].sort((a,b) => a.localeCompare(b,'zh'));
---
<Layout title="分享 · 清吾">
  <div class="page-shell">
    <header class="share-head">
      <h1>分享</h1>
      <p>收藏的好东西，和打动我的句子。</p>
    </header>
    {shares.length ? <qingwu-share>
      {tags.length > 0 && <div class="tag-bar" role="group" aria-label="按标签筛选">
        {tags.map(tag => <button type="button" data-tag={tag} aria-pressed="false">#{tag}</button>)}
      </div>}

      <div class="collection" data-share-list>
        {sections.filter(section => section.items.length).map(group => (
          <section class={group.kind} data-share-section aria-labelledby={`share-${group.kind}`}>
            <h2 id={`share-${group.kind}`}>{group.title}</h2>
            <div class="items">
              {group.items.map(item => item.type === 'link' ? (
                <a class="bookmark" data-type="link" data-tags={JSON.stringify(item.tags)}
                  href={item.url} target="_blank" rel="noopener noreferrer">
                  <span class="domain">{item.url.replace(/^https?:\/\//,'').split('/')[0] || item.url}</span>
                  <span class="bookmark-title">{item.title}<span class="arrow" aria-hidden="true">↗</span></span>
                  {item.note && <span class="note">{item.note}</span>}
                  {item.tags.length > 0 && <span class="labels">{item.tags.map(tag => <span>#{tag}</span>)}</span>}
                </a>
              ) : (
                <button class="flip-card" data-type="quote" data-tags={JSON.stringify(item.tags)}
                  type="button" aria-pressed="false" aria-label={`翻面：${item.text}`}>
                  <span class="flip-inner">
                    <span class="flip-face front">
                      {group.kind === 'postcard' && <img class="illustration" src="https://img.qingwu.ink/site/covers/home-reply-5b8979d3a69d.webp" width="1440" height="810" alt="" />}
                      <span class="writing">
                        <span class="quotation">{item.text}</span>
                        {item.tags.length > 0 && <span class="labels">{item.tags.map(tag => <span>#{tag}</span>)}</span>}
                      </span>
                    </span>
                    <span class="flip-face flip-back" aria-hidden="true">
                      <span class="source-label">摘录来源</span>
                      <span class="source">{item.author || '未署名'}</span>
                    </span>
                  </span>
                </button>
              ))}
            </div>
          </section>
        ))}
      </div>
    </qingwu-share> : <div class="q-empty">
      <p class="q-empty__hand">这里还很空 ~</p><p class="q-empty__sub">收藏和语录都还在攒，先去友链认识几个新朋友？</p>
      <a href="/links" class="q-empty-btn">去友链看看</a>
    </div>}
  </div>
</Layout>

<script>
  class ShareCollection extends HTMLElement {
    private tag: string | null = null;
    connectedCallback() { this.addEventListener('click', this.handleClick); }
    disconnectedCallback() { this.removeEventListener('click', this.handleClick); }
    private handleClick = (event: MouseEvent) => {
      const button = event.target instanceof Element ? event.target.closest('button') : null;
      if (!button) return;
      if (button.matches('.flip-card')) {
        const back = button.classList.toggle('is-flipped');
        button.setAttribute('aria-pressed', String(back));
        button.querySelector('.front')?.setAttribute('aria-hidden', String(back));
        button.querySelector('.flip-back')?.setAttribute('aria-hidden', String(!back));
        const text = button.querySelector(back ? '.source' : '.quotation')?.textContent;
        button.setAttribute('aria-label', back ? `摘录来源：${text}，翻回正面` : `翻面：${text}`);
        return;
      }
      if (button.dataset.tag === undefined) return;
      this.tag = this.tag === button.dataset.tag ? null : button.dataset.tag;
      this.querySelectorAll<HTMLElement>('[data-tag]').forEach(control => {
        control.setAttribute('aria-pressed', String(control.dataset.tag === this.tag));
      });
      this.querySelectorAll<HTMLElement>('[data-type]').forEach(item => {
        item.hidden = this.tag !== null && !JSON.parse(item.dataset.tags || '[]').includes(this.tag);
      });
      this.querySelectorAll<HTMLElement>('[data-share-section]').forEach(section => {
        section.hidden = !section.querySelector('[data-type]:not([hidden])');
      });
    };
  }
  if (!customElements.get('qingwu-share')) customElements.define('qingwu-share', ShareCollection);
</script>

<style>
  qingwu-share { display:block; }
  qingwu-share [hidden] { display:none; }
  .share-head { display:flex; align-items:baseline; flex-wrap:wrap; gap:.5rem 1.4rem; margin-bottom:1.6rem; }
  h1,h2,.quotation,.source,.bookmark-title { font-family:var(--font-display); font-weight:400; }
  h1 { font-size:clamp(2.6rem,5vw,4rem); line-height:1.12; }
  .share-head p,.note,.domain,.labels { color:var(--color-muted); }
  .tag-bar,.labels { display:flex; align-items:baseline; flex-wrap:wrap; gap:.5rem 1.6rem; }
  .labels,.domain,.source-label { font-size:.78rem; }
  .tag-bar { margin-top:1rem; gap:.6rem; }
  .tag-bar button { padding:.35rem .65rem; font-size:.85rem; }
  .tag-bar [aria-pressed=true] { color:var(--color-accent); text-decoration:underline; }
  .collection { display:grid; grid-template-columns:minmax(0,1.4fr) minmax(0,1fr); gap:2.5rem clamp(2rem,5vw,4.5rem); margin-top:1.65rem; align-items:start; }
  .collection:not(:has(.postcard:not([hidden]))) .bookmarks,.notebook { grid-column:1/-1; }
  h2 { font-size:1.45rem; margin-bottom:.9rem; }
  .flip-card { display:block; width:100%; text-align:start; color:var(--color-ink); }
  .flip-face { display:flex; flex-direction:column; background:var(--color-cream); backdrop-filter:blur(8px); }
  .postcard .flip-face { padding:.55rem; border-radius:.35rem; box-shadow:0 12px 24px -16px var(--color-brown); }
  .illustration { width:100%; height:clamp(11rem,18vw,15rem); object-fit:cover; object-position:50% 47%; }
  .writing { display:flex; flex:1; align-items:start; flex-direction:column; gap:.6rem; padding:1.25rem; }
  .quotation { font-size:clamp(1.12rem,1.7vw,1.45rem); line-height:1.65; overflow-wrap:anywhere; }
  .postcard .quotation { font-size:clamp(1.45rem,2.35vw,2rem); line-height:1.5; }
  .flip-back { align-items:center; justify-content:center; gap:.55rem; background:var(--color-cream); }
  .source { font-size:1.5rem; }
  .source-label { color:var(--color-subtle); }
  .bookmark { display:flex; flex-direction:column; gap:.45rem; padding:1.2rem .15rem; border-top:1px solid var(--color-hairline); overflow-wrap:anywhere; }
  .bookmarks .items { border-bottom:1px solid var(--color-hairline); }
  .bookmark-title { display:flex; align-items:baseline; justify-content:space-between; gap:.7rem; font-size:clamp(1.25rem,2.3vw,1.8rem); }
  .arrow,.bookmark:hover .bookmark-title { color:var(--color-accent); }
  .arrow { font:1.1rem system-ui; }
  .domain { letter-spacing:.04em; }
  .note { font-size:.94rem; }
  .notebook .items { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem 1.25rem; }
  .notebook .flip-card { position:relative; border-radius:1.3rem; }
  /* The glass stays in the page plane so it samples the background as the text flips. */
  .notebook .flip-card::before {
    content:''; position:absolute; inset:0; border-radius:inherit; pointer-events:none;
    background-color:rgba(255,248,242,.76);
    background-image:
      radial-gradient(ellipse at 7% 0%, rgba(255,255,255,.65), transparent 46%),
      linear-gradient(132deg,rgba(255,255,255,.25),transparent 43%,rgba(255,210,192,.12) 77%,rgba(255,255,255,.35));
    box-shadow:inset 1px 1.5px 1px rgba(255,255,255,.97),
      inset -1px -1.5px 1px rgba(255,255,255,.8), inset 0 -3px 5px rgba(178,103,104,.16),
      0 5px 15px -9px rgba(110,54,67,.36);
  }
  @supports (backdrop-filter:blur(1px)) {
    .notebook .flip-card::before {
      background-color:rgba(255,249,245,.18);

      backdrop-filter:blur(11px) saturate(150%);
    }
  }
  .notebook .flip-face {
    min-height:6.25rem; justify-content:center; padding:1.25rem clamp(1.1rem,2.5vw,2rem);
    border-radius:inherit; background:transparent; backdrop-filter:none;
  }
  .notebook .writing { flex:0; padding:0; }
  .notebook .flip-card:hover::before { background-color:rgba(255,249,245,.4); }
  :global(html.q-contrast) .notebook .flip-card::before { background:var(--color-cream); }
  @media (prefers-reduced-transparency: reduce) {
    .notebook .flip-card::before { background:var(--color-cream); backdrop-filter:none; }
  }
  .tag-bar button:focus-visible,.bookmark:focus-visible,.flip-card:focus-visible { outline:2px solid var(--color-accent); outline-offset:3px; }
  @media (max-width:720px) {
    .collection,.notebook .items { grid-template-columns:1fr; }
    .collection { gap:1.8rem; }
    .share-head { margin-bottom:1rem; }
    .writing { padding:1rem .75rem .7rem; }
  }
  @media (prefers-reduced-motion: reduce) { .flip-inner { transition:none; } }
</style>

---
import Layout from '../../layouts/Layout.astro';
import { changelog, changelogUpdated, formatDate } from '../../data/changelog';

const total = changelog.length;
---

<Layout
  title="更新日志 · 清吾"
  description="这个小站改过什么，按版本记着——最新的一版在最上面。"
>
  {/*
    窄栏：**不要给 .page-shell 覆盖 max-w**（见关于页注释）——外壳不动，窄栏下沉到内层。
    更新日志是长文本列表，版心比正文再收一点，读到行尾不费劲。
  */}
  <div class="page-shell">
    <div class="max-w-[58rem]">
      <header class="page-head">
        <h1 class="page-head__title">更新日志</h1>
        <p class="page-head__sub">这个小站改过什么，都在这里。最新的在最上面。</p>
        <p class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-muted">
          <span>{total} 个版本</span>
          <span class="text-subtle" aria-hidden="true">·</span>
          <span>
            最近更新
            <time class="tabular-nums" datetime={changelogUpdated}>
              {formatDate(changelogUpdated)}
            </time>
          </span>
        </p>
      </header>

      {/* 竖向时间轴：轴线与圆点由 .q-log* 画（effects.css），窄屏直接收掉轴线只留卡片 */}
      <ol class="q-log" data-changelog>
        {
          changelog.map((e) => (
            <li
              class={`q-log__item${e.latest ? ' q-log__item--latest' : ''}`}
              data-log-entry
              data-version={e.version}
            >
              <span class="q-log__dot" aria-hidden="true" />

              <article class="glass-card reveal p-6 sm:p-8">
                <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                  <span class="q-log__ver tabular-nums">{e.version}</span>
                  {e.latest && <span class="q-log__badge">最新</span>}
                  <time class="q-log__date tabular-nums" datetime={e.date}>
                    {formatDate(e.date)}
                  </time>
                </div>

                <h2 class="card-head mt-2.5">{e.title}</h2>
                <p class="mt-2 leading-[1.85] text-muted">{e.summary}</p>

                <div class="mt-6 space-y-5">
                  {e.groups.map((g) => (
                    <section>
                      <h3 class="q-log__label">{g.label}</h3>
                      <ul class="mt-2.5 space-y-2">
                        {g.items.map((it) => (
                          <li class="q-log__li">
                            <span class="q-log__bullet" aria-hidden="true" />
                            <span>{it}</span>
                          </li>
                        ))}
                      </ul>
                    </section>
                  ))}
                </div>
              </article>
            </li>
          ))
        }
      </ol>

      <p class="mt-8 flex items-center gap-2 text-xs text-subtle">
        <span aria-hidden="true">·</span>
        <span>再往前就没有记录了——v2.0 是这站第一次上线。</span>
      </p>

      <div class="mt-10">
        <a
          href="/about"
          class="group inline-flex items-center gap-1.5 text-sm text-accent hover:underline"
        >
          <span
            aria-hidden="true"
            class="transition-transform duration-300 group-hover:-translate-x-1">←</span
          >
          回关于页
        </a>
      </div>
    </div>
  </div>
</Layout>

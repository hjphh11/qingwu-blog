---
import Layout from '../../layouts/Layout.astro';
import ReadingProgress from '../../components/ReadingProgress.tsx';
import EmisCompanion from '../../components/emis/EmisCompanion.tsx';
import ContactExpand from '../../components/ContactExpand.tsx';
import MorphIcon from 'morphicons/astro';
import { List, ArrowLeft } from '../../lib/icons';
import { getCollection, render } from 'astro:content';
import { categoryLabel } from '../../data/categories';
import { SITE } from '../../config';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) => !p.data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const catLabel = categoryLabel(post.data.category);
const chars = (post.body || '').replace(/\s/g, '').length;
const readMin = Math.max(1, Math.round(chars / 400));

const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<Layout title={`${post.data.title} · 清吾`}>
  <ReadingProgress client:load />

  {/* 阅读页的宽度**不跟着版心一起放大**：正文一行的舒适区是 28~40 个汉字，
      68ch 已经顶到 40 字（1440 下实测 678px）。版心放到 1160 之后如果还铺满，
      文字只占左边一截、目录被推到最右，中间空出两百多像素反而更散。
      所以这里把两栏下沉进一个 63rem 的内框（左缘仍与导航同线，不居中），
      多出来的画布宽度当成左右留白用。 */}
  <div class="page-shell">
    <div class="grid max-w-[63rem] gap-8 lg:grid-cols-[minmax(0,1fr)_240px]">
      {/* 正文 */}
      <article class="min-w-0">
        <header class="mb-10">
          <button
            id="back-btn"
            type="button"
            class="mb-5 -ml-2 inline-flex cursor-pointer items-center gap-1.5 px-2 py-2 text-sm text-muted transition-colors hover:text-accent"
          >
            <span aria-hidden="true">
              <MorphIcon icon={ArrowLeft} size={16} color="currentColor" />
            </span>
            返回
          </button>
          <div class="list-card-meta">
            <span class="chip chip--category">{catLabel}</span>
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('zh-CN')}
            </time>
            <span aria-hidden="true">·</span>
            <span>阅读约 {readMin} 分钟</span>
            {/* 真实阅读量：数据来自 D1 的 hits（口径同后台统计）。先 hidden，
                脚本拿到数字才显示 —— 拿不到或为 0 就当作没有这个东西，绝不留一个空的「阅读 次」。 */}
            <span data-views-path={`/blog/${post.id}`} hidden>
              <span aria-hidden="true">·</span>
              阅读 <span data-views-num></span> 次
            </span>
          </div>
          <h1
            class="q-post-title mt-5 font-display text-[length:var(--text-display)] leading-[1.2] text-ink"
          >
            {post.data.title}
          </h1>
          <div class="mt-5 flex flex-wrap gap-x-3 gap-y-1">
            {
              post.data.tags.map((tag) => (
                <span class="text-[length:var(--text-label)] text-subtle">#{tag}</span>
              ))
            }
          </div>
        </header>

        <div class="prose max-w-[68ch]">
          <Content />
        </div>

        {/* 分享 · 展开按钮 */}
        <div class="mt-14 flex justify-center">
          <ContactExpand
            client:load
            variant="share"
            label="分享"
            url={`${SITE.url}/blog/${post.id}`}
            title={post.data.title}
            email={SITE.email}
          />
        </div>
      </article>

      {/* 右侧目录 */}
      <aside class="hidden lg:block">
        <nav class="sticky top-28 self-start">
          <div class="mb-3 flex items-center gap-2 text-sm font-medium text-muted">
            <MorphIcon icon={List} size={16} color="currentColor" />
            目录
          </div>
          <ul data-toc class="space-y-1.5 border-l border-rose/25 pl-4 text-sm">
            {
              toc.map((h) => (
                <li class={`q-toc__item${h.depth === 3 ? ' q-toc__item--sub pl-4' : ''}`}>
                  <a
                    href={`#${h.slug}`}
                    data-toc-link={h.slug}
                    class="q-toc__link block py-0.5 transition-colors hover:text-accent"
                  >
                    {h.text}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </aside>
    </div>
  </div>

  {/* 小陪伴：三种形态（角落 / 滚动探头 / 文末）每次进文章页随机掷一个。
      client:only —— 形态是客户端随机决定的，服务端无从预知；
      而且它只是个固定定位的装饰层，不需要 SSR。 */}
  <EmisCompanion client:only="react" />
</Layout>

<script>
  /*
   * ⚠️ 两个必须：
   * 1. **不能在这里直接绑元素**。Astro 的 `<script>` 是模块，首屏执行一次之后，
   *    客户端路由切页不会重跑；而 ClientRouter 会把整个 body 换掉 —— 于是
   *    「从别的页面点进文章」时绑定全落在已经丢弃的旧节点上（后退按钮原来就点不动）。
   * 2. **首屏也要主动初始化一次**。不能只靠 `astro:page-load`：那个事件有可能在
   *    本脚本求值之前就派发完了（实测首屏拿不到高亮，就是因为它错过了）。
   *    所以「DOM 就绪就跑一次」+「监听后续导航」，并且做成幂等。
   */
  let teardown: (() => void) | null = null;

  function init() {
    // 幂等：重复进入（或首屏既跑了立即初始化、又收到 page-load）时先清掉上一次
    teardown?.();
    teardown = null;

    const back = document.getElementById('back-btn');
    const onBack = () => {
      if (history.length > 1) history.back();
      else window.location.href = '/blog';
    };
    back?.addEventListener('click', onBack);

    const toc = document.querySelector('[data-toc]');
    if (!toc) {
      teardown = () => back?.removeEventListener('click', onBack);
      return;
    }

    /* ── TOC 当前项（v6 §7.3：当前项左侧 2px 光线）──
       ⚠️ 这里**没有**用 IntersectionObserver。原因是它的回调只在「相交状态发生变化」时
       触发：当视口处在两个标题之间、且没有任何标题落在判定带里时，滚动不会产生回调，
       目录就会卡在上一个高亮不动 —— 而这恰好是最需要更新的场景（实测复现）。
       改成 rAF 节流的 scroll 计算：一帧最多算一次，9 个标题的 rect 读取代价可以忽略，
       而且任何滚动位置都有确定结果。 */
    const links = new Map<string, HTMLAnchorElement>();
    toc.querySelectorAll<HTMLAnchorElement>('[data-toc-link]').forEach((a) => {
      links.set(a.dataset.tocLink || '', a);
    });

    const heads = Array.from(
      document.querySelectorAll<HTMLElement>('article h2[id], article h3[id]'),
    );

    let current = '';
    const setActive = (id: string) => {
      if (id === current) return;
      current = id;
      links.forEach((a, key) => a.classList.toggle('is-active', key === id));
    };

    let raf = 0;
    const pick = () => {
      raf = 0;
      if (!heads.length) return;
      /* 判定线放在视口 30% 处：最后一个「已经越过这条线」的标题就是当前章节。
         全都没越过（还在引言）时点亮第一项 —— 不点亮任何一项会让人以为目录坏了。 */
      const line = window.innerHeight * 0.3;
      let idx = 0;
      for (let i = 0; i < heads.length; i++) {
        if (heads[i].getBoundingClientRect().top <= line) idx = i;
        else break;
      }
      setActive(heads[idx].id);
    };
    const onScroll = () => {
      if (!raf) raf = requestAnimationFrame(pick);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    pick();

    // 带 hash 进来时以它为准（滚动位置可能还没生效，pick 会算错一帧）
    const hash = decodeURIComponent(location.hash.slice(1));
    if (hash && links.has(hash)) setActive(hash);

    /* ── 目录点击：滑过去，不是瞬移 ──
       默认的锚点跳转是「瞬间贴合」，长文里会让人失去位置感。
       这里自己做一段缓动滚动：
       · 落点偏移读 `scroll-margin-top`（写在 prose.css），因为导航是 fixed 的，
         不扣掉的话标题会藏到导航底下；
       · 用户一动滚轮/手指/键盘就立刻交出控制权（别把人拽住）；
       · 「减少动效」直接到位。 */
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const easeInOutCubic = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

    let stopGlide: (() => void) | null = null;

    const glideTo = (el: HTMLElement) => {
      stopGlide?.();

      const margin = parseFloat(getComputedStyle(el).scrollMarginTop) || 0;
      const maxY = document.documentElement.scrollHeight - window.innerHeight;
      const end = Math.min(Math.max(0, el.getBoundingClientRect().top + window.scrollY - margin), maxY);
      const start = window.scrollY;
      const dist = end - start;

      if (Math.abs(dist) < 2 || reduced.matches) {
        window.scrollTo(0, end);
        return;
      }

      /* 时长跟距离走，但有上下限：短距离拖太久像卡住，长距离太快又晕 */
      const dur = Math.min(720, Math.max(320, Math.abs(dist) * 0.5));
      const t0 = performance.now();
      let raf2 = 0;

      const stop = () => {
        if (raf2) cancelAnimationFrame(raf2);
        raf2 = 0;
        window.removeEventListener('wheel', stop);
        window.removeEventListener('touchstart', stop);
        window.removeEventListener('keydown', stop);
        if (stopGlide === stop) stopGlide = null;
      };
      window.addEventListener('wheel', stop, { passive: true });
      window.addEventListener('touchstart', stop, { passive: true });
      window.addEventListener('keydown', stop);
      stopGlide = stop;

      const step = (now: number) => {
        const p = Math.min(1, (now - t0) / dur);
        window.scrollTo(0, start + dist * easeInOutCubic(p));
        if (p < 1) raf2 = requestAnimationFrame(step);
        else stop();
      };
      raf2 = requestAnimationFrame(step);
    };

    const onTocClick = (event: MouseEvent) => {
      const a = (event.target as HTMLElement | null)?.closest<HTMLAnchorElement>('[data-toc-link]');
      if (!a) return;
      /* 带修饰键的点击是「新标签页打开 / 复制链接」，别抢 */
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

      const id = a.dataset.tocLink || '';
      const el = id ? document.getElementById(id) : null;
      if (!el) return;

      event.preventDefault();
      // 地址栏仍要带 hash（可分享），但不新增历史记录
      history.replaceState(null, '', `#${id}`);
      // 目录跳转是「向下滚」，导航会按滚动方向收起 —— 但落点上方还留着
      // prose.css 的 scroll-margin-top（6.5rem，是照导航高度写的）。
      // 导航这时要是不在了，标题上面就会空出一块。先把它请回来再滚。
      window.dispatchEvent(new CustomEvent('q:reveal-nav'));
      glideTo(el);
    };
    toc.addEventListener('click', onTocClick);

    teardown = () => {
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onScroll);
      if (raf) cancelAnimationFrame(raf);
      toc.removeEventListener('click', onTocClick);
      stopGlide?.();
      back?.removeEventListener('click', onBack);
    };
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }
  document.addEventListener('astro:page-load', init);
</script>

<script is:inline>
  /*
   * 单篇阅读量。数据源：Worker 的 GET /post-views（见 worker/src/views.ts）。
   *
   * · 取 base 的方式与打点一致：Layout 注入的 <meta name="q-hit-endpoint"> 去掉 /hit。
   *   线上是 https://api.qingwu.ink，局域网自建版是 /api —— 两边都不用改一行代码。
   * · **失败一律静默**。这是一个装饰性的数字，拿不到就不显示，绝不能在页面上留个
   *   「阅读 次」的空壳，也不该为一个数字往控制台里丢错误。
   * · 首次进入和客户端路由切页都要跑（astro:page-load），并且靠 data-views-done 幂等。
   */
  (function () {
    var DONE = 'data-views-done';

    function apiBase() {
      var meta = document.querySelector('meta[name="q-hit-endpoint"]');
      var ep = (meta && meta.getAttribute('content')) || 'https://api.qingwu.ink/hit';
      return ep.replace(/\/hit$/, '');
    }

    function fmt(n) {
      if (n >= 10000) return (n / 10000).toFixed(1).replace(/\.0$/, '') + ' 万';
      return String(n);
    }

    function fill() {
      var hosts = document.querySelectorAll('[data-views-path]');
      if (!hosts.length) return;
      var url = apiBase() + '/post-views';

      Array.prototype.forEach.call(hosts, function (el) {
        if (el.getAttribute(DONE) === '1') return;
        var p = el.getAttribute('data-views-path');
        if (!p) return;
        el.setAttribute(DONE, '1');

        fetch(url + '?path=' + encodeURIComponent(p), { credentials: 'omit' })
          .then(function (r) {
            return r.ok ? r.json() : null;
          })
          .then(function (d) {
            if (!d || d.ok !== true) return;
            var pv = Number(d.pv);
            if (!(pv > 0)) return;
            var num = el.querySelector('[data-views-num]');
            if (num) num.textContent = fmt(pv);
            el.hidden = false;
          })
          .catch(function () {
            /* 静默：拿不到就当没有这个数字 */
          });
      });
    }

    fill();
    document.addEventListener('astro:page-load', fill);
  })();
</script>


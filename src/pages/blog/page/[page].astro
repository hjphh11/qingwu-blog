---
import Layout from '../../../layouts/Layout.astro';
import BlogList from '../../../components/BlogList.astro';
import { getPublishedPosts, PAGE_SIZE } from '../../../lib/posts';

export async function getStaticPaths() {
  const allPosts = await getPublishedPosts();
  const pages = Math.ceil(allPosts.length / PAGE_SIZE);
  return Array.from({ length: Math.max(0, pages - 1) }, (_, i) => ({
    params: { page: String(i + 2) }, props: { allPosts, currentPage: i + 2 },
  }));
}
const { allPosts, currentPage } = Astro.props;
---
<Layout title={`文章 · 第 ${currentPage} 页 · 清吾`}>
  <div class="page-shell"><BlogList {allPosts} {currentPage} /></div>
</Layout>

---
import Layout from '../../../layouts/Layout.astro';
import BlogList from '../../../components/BlogList.astro';
import { getPublishedPosts, PAGE_SIZE } from '../../../lib/posts';

export async function getStaticPaths() {
  const ALL = await getPublishedPosts();
  const totalPages = Math.max(1, Math.ceil(ALL.length / PAGE_SIZE));
  const paths = [];
  for (let p = 2; p <= totalPages; p++) {
    paths.push({
      params: { page: String(p) },
      props: {
        pageNum: p,
        pagePosts: ALL.slice((p - 1) * PAGE_SIZE, p * PAGE_SIZE),
        lastPage: totalPages,
      },
    });
  }
  return paths;
}

const { pageNum, pagePosts, lastPage } = Astro.props;
---

<Layout title="文章 · 清吾">
  <div class="mx-auto max-w-4xl px-6 pb-20 pt-28">
    <BlogList posts={pagePosts} currentPage={pageNum} lastPage={lastPage} />
  </div>
</Layout>

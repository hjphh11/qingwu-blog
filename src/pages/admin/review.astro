---
/*
 * /admin/review —— 评论审核（规则 + 拦截记录）
 *
 * 和其他后台页一样是静态预渲染：进来先打 /api/admin/session，401 跳回 /admin。
 * 规则读写走 GET/PATCH /api/admin/settings；拦截记录走 GET /api/admin/review/blocked。
 *
 * 没有「试判」了（2026-11-10 晚站长砍掉）—— 判得准不准靠真实误判反馈，
 * 也就是这一页底部那些拦截记录：看到误判就去收件箱放行，再回头调阈值。
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminReview from '../../components/admin/AdminReview.tsx';
---

<AdminLayout title="评论审核">
  <AdminReview client:load />
</AdminLayout>

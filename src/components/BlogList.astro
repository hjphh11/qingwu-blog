---
import MorphIcon from 'morphicons/astro';
import { categories, categoryLabel } from '../data/categories';
import { categoryIcon } from '../lib/categoryIcons';

interface Props {
  posts: any[];
  currentPage: number;
  lastPage: number;
}
const { posts, currentPage, lastPage } = Astro.props;

// 筛选按钮由分类表动态生成（后台加分类后这里自动跟着变，不再写死 tech/life）
const filters = [
  { key: 'all', label: '全部' },
  ...categories.map((c) => ({ key: c.id, label: c.label })),
];
const pageHref = (n: number) => (n === 1 ? '/blog' : `/blog/page/${n}/`);
const pages = Array.from({ length: lastPage }, (_, i) => i + 1);
const prevHref = currentPage > 1 ? pageHref(currentPage - 1) : null;
const nextHref = currentPage < lastPage ? pageHref(currentPage + 1) : null;
---

<header class="page-head reveal">
  <h1 class="page-head__title">文章</h1>
  <p class="page-head__sub">写下的故事，都收在这里 ~</p>
</header>

<div class="mb-10 flex flex-wrap gap-2" id="post-filters" role="group" aria-label="按分类筛选">
  {
    filters.map((f) => (
      <button
        type="button"
        data-filter={f.key}
        aria-pressed={f.key === 'all' ? 'true' : 'false'}
        class="filter-chip btn-ripple"
      >
        {f.label}
      </button>
    ))
  }
</div>

{
  posts.length > 0 ? (
    /* 宽屏两列：版心放到 1240（净 1160）之后，单列卡片会有半张空着 ——
       摘要按阅读舒适区限在 34em，剩下一半只有标签和右下角那个小图标。
       一列 1160 的卡不是「大气」而是「没加载完」。所以 ≥1100 转两列（每张 572），
       筛选按钮还是按 display 隐藏卡片，grid 下照样能收。
       ⚠️ 两列的卡片顺序变成**从左到右**读，条目多时扫读反而更快（列表页不是正文）。 */
    <div
      id="post-list"
      class="reveal flex flex-col gap-6 min-[1100px]:grid min-[1100px]:grid-cols-2 min-[1100px]:items-stretch"
    >
      {posts.map((post) => (
        <a
          href={`/blog/${post.id}`}
          data-category={post.data.category}
          class="glass-card card-spotlight group relative block p-7 card-lift sm:p-8"
        >
          <span
            class="absolute right-5 top-5 text-rose transition-colors group-hover:text-crimson"
            aria-hidden="true"
          >
            <MorphIcon
              icon={categoryIcon(post.data.category) as never}
              size={18}
              color="currentColor"
            />
          </span>
          <div class="list-card-meta">
            <span class="chip chip--category">{categoryLabel(post.data.category)}</span>
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('zh-CN')}
            </time>
          </div>
          <h2 class="list-card-title pr-8">{post.data.title}</h2>
          <p class="list-card-desc line-clamp-2">{post.data.description}</p>
          <div class="list-card-foot">
            {post.data.tags.map((tag: string) => <span class="chip chip--tag">#{tag}</span>)}
          </div>
        </a>
      ))}
    </div>
  ) : (
    /* 空态是构建期内容决定的,「重新加载」给不出任何出口 —— 所以按钮指向
       一个真实去处,而不是假装刷新一下(见 global.css 的 .q-empty*)。 */
    <div class="glass-card q-empty p-12">
      <p class="q-empty__hand">这里还很空 ~</p>
      <p class="q-empty__sub">内容还在路上，稍后再来逛逛</p>
      <a href="/" class="q-empty-btn">回首页看看</a>
    </div>
  )
}

<nav aria-label="分页" class="mt-14 flex items-center justify-center gap-2">
  {
    prevHref ? (
      <a href={prevHref} class="page-link page-link--edge">
        上一页
      </a>
    ) : (
      <span class="page-link page-link--edge page-link--disabled" aria-disabled="true">
        上一页
      </span>
    )
  }
  {
    pages.map((n) => (
      <a
        href={pageHref(n)}
        aria-current={n === currentPage ? 'page' : undefined}
        class={`page-link${n === currentPage ? ' page-link--current' : ''}`}
      >
        {n}
      </a>
    ))
  }
  {
    nextHref ? (
      <a href={nextHref} class="page-link page-link--edge">
        下一页
      </a>
    ) : (
      <span class="page-link page-link--edge page-link--disabled" aria-disabled="true">
        下一页
      </span>
    )
  }
</nav>

<script>
  /*
   * ⚠️ 两个坑都在这里：
   * ① 直接 querySelector 绑事件在客户端路由下会失效（模块脚本首屏只跑一次，
   *    ClientRouter 换掉 body 后不重跑）—— 从首页点进文章列表时筛选按钮是死的。
   *    所以包成 init()：监听 astro:page-load，**并且 DOM 就绪自己也跑一次**
   *    （首屏的 page-load 可能在本脚本求值之前就派发完了）。
   * ② 首页左栏的分类链接带 ?category=xxx，之前读都没读，点过来还是「全部」。
   */
  let teardown = () => {};

  function init() {
    teardown();

    const list = document.getElementById('post-list');
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('#post-filters button'));
    if (!buttons.length) return;

    const setActive = (key: string) => {
      buttons.forEach((b) => {
        const on = b.getAttribute('data-filter') === key;
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
        b.classList.toggle('is-active', on);
      });
      if (!list) return;
      list.querySelectorAll<HTMLElement>('[data-category]').forEach((card) => {
        const cat = card.getAttribute('data-category');
        const show = key === 'all' || cat === key;
        card.style.display = show ? '' : 'none';
      });
    };

    // 先存「绑定好的函数」再 addEventListener，否则 removeEventListener
    // 拿到的是另一个新闭包，摘不掉（切回页面会叠监听）
    const hooks = buttons.map((b) => [b, () => setActive(b.getAttribute('data-filter') || 'all')] as const);
    hooks.forEach(([b, fn]) => b.addEventListener('click', fn));
    teardown = () => hooks.forEach(([b, fn]) => b.removeEventListener('click', fn));

    // 从首页左栏的分类进来：/blog?category=tech
    const wanted = new URLSearchParams(location.search).get('category');
    if (wanted && buttons.some((b) => b.getAttribute('data-filter') === wanted)) setActive(wanted);
  }

  document.addEventListener('astro:page-load', init);
  if (document.readyState !== 'loading') init();
  else document.addEventListener('DOMContentLoaded', init, { once: true });
</script>

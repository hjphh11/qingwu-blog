---
import type { CollectionEntry } from 'astro:content';
import { categories, categoryLabel } from '../data/categories';
import { PAGE_SIZE } from '../lib/posts';

interface Props {
  allPosts: CollectionEntry<'blog'>[];
  currentPage?: number;
  category?: string;
}
const { allPosts, currentPage = 1, category } = Astro.props;
const selected = category ? allPosts.filter(post => post.data.category === category) : allPosts;
const lastPage = Math.max(1, Math.ceil(selected.length / PAGE_SIZE));
const posts = selected.slice((currentPage - 1) * PAGE_SIZE, currentPage * PAGE_SIZE);
const filters = [
  { id: undefined, label: '全部', count: allPosts.length },
  ...categories.map(c => ({ ...c, count: allPosts.filter(p => p.data.category === c.id).length })),
];
const base = category ? `/blog/category/${category}/` : '/blog/';
const pageHref = (n: number) => n === 1 ? base : `${base}page/${n}/`;
const date = (day: Date) => day.toISOString().slice(0, 10);
---
<header class="archive-head">
  <h1>文章</h1>
  <p>写下的故事，都收在这里。</p>
</header>
<nav class="archive-tabs" aria-label="按分类看文章">
  {filters.map(f => (
    <a href={f.id ? `/blog/category/${f.id}/` : '/blog/'} data-filter={f.id}
      aria-current={f.id === category ? 'page' : undefined}>
      {f.label}<span>{f.count}</span>
    </a>
  ))}
</nav>

<div class="archive-list">
  {posts.map((post, index) => {
    const feature = currentPage === 1 && index === 0;
    const day = date(post.data.pubDate);
    return (
      <article class:list={['entry', { feature }]}>
        <a class="entry-link" href={`/blog/${post.id}/`}>
          {feature ? (
            <img class="feature-cover" src={post.data.cover || 'https://img.qingwu.ink/site/covers/home-friends-9d8b71630bd3.webp'}
              width="1200" height="675" alt="" decoding="async" />
          ) : (
            <time class="index-date" datetime={day}><strong>{day.slice(5).replace('-', '.')}</strong><span>{day.slice(0,4)}</span></time>
          )}
          <div class="entry-copy">
            <div class="byline">
              <span>{categoryLabel(post.data.category)}</span>
              {feature && <time datetime={day}>{day.replaceAll('-', '.')}</time>}
              {post.data.pinned && <span>置顶</span>}
            </div>
            <h2>{post.data.title}</h2>
            {post.data.description && <p class="excerpt">{post.data.description}</p>}
            {feature
              ? <span class="read">阅读全文 <span aria-hidden="true">→</span></span>
              : post.data.tags.length > 0 && <div class="tags">{post.data.tags.map(tag => <span>#{tag}</span>)}</div>}
          </div>
          {!feature && post.data.cover && <img class="thumbnail" src={post.data.cover} alt="" width="176" height="112" loading="lazy" />}
        </a>
      </article>
    );
  })}
  {!posts.length && <div class="q-empty"><p class="q-empty__hand">这里还没有文章</p><a class="q-empty-btn" href={category ? '/blog/' : '/'}>{category ? '查看全部文章' : '回首页看看'}</a></div>}
</div>
{lastPage > 1 && <nav class="pager" aria-label="分页">
  {currentPage > 1 && <a href={pageHref(currentPage-1)} aria-label="上一页">←</a>}
  {Array.from({length:lastPage}, (_,i) => i+1).map(n => <a href={pageHref(n)} aria-label={`第 ${n} 页`} aria-current={n === currentPage ? 'page' : undefined}>{n}</a>)}
  {currentPage < lastPage && <a href={pageHref(currentPage+1)} aria-label="下一页">→</a>}
</nav>}

<script>
  // Preserve bookmarks from the original query-based filter.
  function openLegacyCategory() {
    const category = new URLSearchParams(location.search).get('category');
    if (!category) return;
    const link = Array.from(document.querySelectorAll<HTMLAnchorElement>('.archive-tabs [data-filter]'))
      .find(item => item.dataset.filter === category);
    if (link) location.replace(link.href);
  }
  openLegacyCategory();
  document.addEventListener('astro:page-load', openLegacyCategory);
</script>

<style>
  .archive-head { display:flex; align-items:baseline; gap:1.4rem; flex-wrap:wrap; margin-bottom:1.6rem; }
  h1, h2, .index-date strong { font-family:var(--font-display); font-weight:400; }
  h1 { font-size:clamp(2.6rem,5vw,4rem); line-height:1.12; }
  .archive-head p,.excerpt,.tags,.index-date span { color:var(--color-muted); }
  .archive-head p { font-size:.96rem; }
  .archive-tabs { display:flex; flex-wrap:wrap; column-gap:1.7rem; border-block:1px solid var(--color-hairline); margin-bottom:1.5rem; }
  .archive-tabs a { display:flex; align-items:baseline; gap:.45rem; padding:.7rem .1rem; border-bottom:2px solid transparent; }
  .archive-tabs a[aria-current] { color:var(--color-accent); border-color:currentColor; }
  .archive-tabs a span { font-size:.72rem; font-variant-numeric:tabular-nums; }
  .entry { border-bottom:1px solid var(--color-hairline); }
  .entry-link { display:flex; gap:clamp(1rem,3vw,2.6rem); align-items:center; padding:1.6rem 0; }
  .entry-copy { min-width:0; flex:1; }
  .feature { border:0; margin-bottom:.8rem; }
  .feature .entry-link { display:grid; grid-template-columns:minmax(0,1.18fr) minmax(0,1fr); gap:0; padding:0; overflow:hidden; border-radius:1.1rem; background:var(--color-cream); box-shadow:0 10px 28px -22px var(--color-brown); }
  .feature-cover { width:100%; height:100%; min-height:18rem; object-fit:cover; }
  .feature .entry-copy { padding:clamp(1.35rem,3.2vw,3rem); }
  .byline { display:flex; align-items:baseline; gap:1em; color:var(--color-accent); font-size:.8rem; }
  .byline time { color:var(--color-subtle); font-variant-numeric:tabular-nums; }
  h2 { color:var(--color-ink); font-size:clamp(1.25rem,2vw,1.65rem); line-height:1.4; margin:.35rem 0; overflow-wrap:anywhere; }
  .feature h2 { font-size:clamp(1.7rem,3vw,2.7rem); line-height:1.25; margin:.75rem 0 1rem; text-wrap:balance; }
  .entry-link:hover h2,.archive-tabs a:hover,.read { color:var(--color-accent); }
  .excerpt { line-height:1.7; font-size:.93rem; display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; overflow:hidden; }
  .feature .excerpt { -webkit-line-clamp:3; }
  .read { display:inline-flex; gap:.65rem; align-items:center; border-bottom:1px solid var(--color-hairline); margin-top:1.35rem; padding-bottom:.15rem; font-size:.88rem; }
  .index-date { display:grid; align-self:start; width:clamp(4.2rem,9vw,7.5rem); flex:none; margin-top:.15rem; }
  .index-date strong { font-size:clamp(1.5rem,3vw,2.35rem); line-height:1.1; color:var(--color-ink); }
  .index-date span,.tags { font-size:.75rem; }
  .tags { display:flex; flex-wrap:wrap; gap:.3rem .9rem; margin-top:.55rem; }
  .thumbnail { width:clamp(7.5rem,15vw,11rem); aspect-ratio:11/7; height:auto; object-fit:cover; border-radius:.6rem; }
  .pager { display:flex; flex-wrap:wrap; justify-content:center; gap:.4rem; margin:2.5rem 0 1rem; }
  .pager a { display:grid; place-items:center; min-width:2.75rem; min-height:2.75rem; border-radius:50%; }
  .pager a[aria-current],.pager a:hover { background:var(--color-cream); color:var(--color-accent); }
  .pager a[aria-current] { outline:1px solid var(--color-hairline); }
  :is(.entry-link,.archive-tabs a,.pager a):focus-visible { outline:2px solid var(--color-accent); outline-offset:3px; }
  @media(max-width:700px) {
    .archive-head { gap:.8rem; margin-bottom:1rem; }
    .feature .entry-link { grid-template-columns:1fr; }
    .feature-cover { min-height:0; height:auto; aspect-ratio:1.95; }
    .feature .entry-copy { padding:1.2rem; }
    .entry:not(.feature) .entry-link { display:grid; grid-template-columns:1fr auto; align-items:start; gap:.3rem 1rem; }
    .index-date { width:auto; display:flex; flex-direction:row-reverse; gap:.3rem; justify-content:end; align-items:baseline; grid-row:1; grid-column:2; }
    .index-date strong,.index-date span { font:inherit; font-size:.78rem; }
    .entry:not(.feature) .entry-copy { grid-column:1/-1; grid-row:1/3; }
    .entry:not(.feature) .byline { padding-right:7rem; }
    .thumbnail { display:none; }
  }
</style>
